@model SubscriptionListViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Suscripciones";
    var tab = Model.Tab;
    var displayList = tab == "pausadas" ? Model.Pausadas
                    : tab == "canceladas" ? Model.Canceladas
                    : Model.Activas;
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show mb-3" role="alert">
        ℹ️ @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 gap-2">
    <p class="mb-0" style="font-size:var(--text-sm);color:var(--text-secondary)">
        @Model.ActiveCount suscripción(es) activa(s)
    </p>
    <button class="btn btn--primary btn--sm" data-bs-toggle="modal" data-bs-target="#addSubModal">
        <i data-lucide="plus" style="width:16px;height:16px"></i> Nueva Suscripción
    </button>
</div>

<!-- ── KPI cards ─────────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="kpi" style="border-left:4px solid var(--brand-500)">
            <span class="kpi__label">🔄 Activas</span>
            <span class="kpi__value" style="color:var(--brand-600)">@Model.ActiveCount</span>
            <span class="kpi__sub">suscripciones activas</span>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi" style="border-left:4px solid #A78BFA">
            <span class="kpi__label">🪙 Mensual CRC</span>
            <span class="kpi__value" style="color:#7c3aed">₡ @Model.TotalMonthlyCrc.ToString("N2")</span>
            <span class="kpi__sub">equivalente mensual</span>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi" style="border-left:4px solid #818CF8">
            <span class="kpi__label">💵 Mensual USD</span>
            <span class="kpi__value" style="color:#4f46e5">$ @Model.TotalMonthlyUsd.ToString("N2")</span>
            <span class="kpi__sub">equivalente mensual</span>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi" style="border-left:4px solid var(--danger-400)">
            <span class="kpi__label">📅 Anual estimado CRC</span>
            <span class="kpi__value" style="color:var(--danger-600)">₡ @Model.TotalAnnualCrc.ToString("N0")</span>
            <span class="kpi__sub">proyección 12 meses</span>
        </div>
    </div>
</div>

<!-- ── Tabs ──────────────────────────────────────────────────────────────── -->
<div style="display:flex;gap:var(--sp-1);background:var(--neutral-100);border-radius:var(--radius-xl);padding:var(--sp-1);margin-bottom:var(--sp-4);width:fit-content">
    @foreach (var t in new[] {
        ("activas",    "✅ Activas",    Model.Activas.Count),
        ("pausadas",   "⏸ Pausadas",   Model.Pausadas.Count),
        ("canceladas", "❌ Canceladas", Model.Canceladas.Count)
    })
    {
        var isActive = (tab == t.Item1) || (tab == "" && t.Item1 == "activas");
        <a href="?tab=@t.Item1"
           style="display:flex;align-items:center;gap:var(--sp-2);padding:var(--sp-2) var(--sp-4);border-radius:var(--radius-lg);font-size:var(--text-sm);font-weight:600;text-decoration:none;transition:all var(--dur-base);@(isActive ? "background:var(--surface-card);color:var(--text-primary);box-shadow:var(--shadow-sm)" : "color:var(--text-muted)")">
            @t.Item2
            <span style="font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;background:@(isActive ? "var(--brand-50)" : "var(--neutral-200)");color:@(isActive ? "var(--brand-600)" : "var(--text-muted)")">@t.Item3</span>
        </a>
    }
</div>

<!-- ── Subscriptions table ───────────────────────────────────────────────── -->
@if (displayList.Any())
{
    <div class="card">
        <div class="card__header">
            <span class="card__title">🔄 Suscripciones @(tab == "pausadas" ? "pausadas" : tab == "canceladas" ? "canceladas" : "activas")</span>
            <span style="font-size:var(--text-xs);color:var(--text-muted)">@displayList.Count registro(s)</span>
        </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Frecuencia</th>
                            <th>Monto</th>
                            <th>Equiv. mensual</th>
                            <th>Próxima renovación</th>
                            <th>Tarjeta</th>
                            <th>Categoría</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in displayList)
                        {
                            var days = s.DaysUntilBilling;
                            var daysColor = days <= 3 ? "#F87171" : days <= 7 ? "#FCD34D" : "#71717A";
                            var daysLabel = days < 0 ? "Vencida" : days == 0 ? "¡Hoy!" : days == 1 ? "Mañana" : $"en {days}d";
                            var amtStr     = s.Amount.ToString("F2", CultureInfo.InvariantCulture);
                            var monthlyStr = s.MonthlyEquivalent.ToString("F2", CultureInfo.InvariantCulture);
                            var startStr   = s.StartDate.ToString("yyyy-MM-dd");
                            var nextStr    = s.NextBillingDate.ToString("yyyy-MM-dd");
                            var notesAttr  = (s.Notes ?? "").Replace("\"", "&quot;").Replace("\n", " ");
                            var catIdStr   = s.CategoryId?.ToString() ?? "";
                            var cardIdStr  = s.CardId?.ToString() ?? "";
                            <tr>
                                <td>
                                    <div style="font-weight:600;font-size:14px">@s.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(s.Merchant))
                                    {
                                        <div style="font-size:11px;color:var(--text-muted)">@s.Merchant</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge" style="background:#6366f122;color:#6366f1;border:1px solid #6366f144;font-size:11px">
                                        @s.FrequencyLabel
                                    </span>
                                </td>
                                <td class="text-money" style="font-weight:600">
                                    @(s.Currency == "USD" ? "$" : "₡") @s.Amount.ToString("N2")
                                </td>
                                <td style="font-size:12px;color:var(--text-muted)">
                                    @(s.Currency == "USD" ? "$" : "₡") @s.MonthlyEquivalent.ToString("N2")
                                    @if (s.Frequency != "mensual")
                                    {
                                        <div style="font-size:10px;color:var(--text-muted)">/mes equiv.</div>
                                    }
                                </td>
                                <td>
                                    <div style="font-size:13px;font-weight:600">@s.NextBillingDate.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size:11px;color:@daysColor;font-weight:600">@daysLabel</div>
                                </td>
                                <td style="font-size:12px;color:var(--text-muted)">
                                    @(s.Card != null ? s.Card.DisplayName : "—")
                                </td>
                                <td>
                                    @if (s.Category != null)
                                    {
                                        <span class="badge-cat" style="background:@(s.Category.Color)22;color:@s.Category.Color;border:1px solid @(s.Category.Color)44">
                                            @s.Category.IconEmoji @s.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-size:11px;color:var(--text-muted)">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end flex-wrap">
                                        <!-- Renew -->
                                        @if (s.Status == "activa")
                                        {
                                            <form method="post" action="/subscriptions/renew/@s.SubscriptionId" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Registrar cobro y avanzar fecha">
                                                    ✔ Cobrado
                                                </button>
                                            </form>
                                        }
                                        <!-- Edit -->
                                        <button class="btn btn-sm btn-outline-secondary"
                                                data-id="@s.SubscriptionId"
                                                data-name="@s.Name"
                                                data-merchant="@(s.Merchant ?? "")"
                                                data-bank="@(s.Bank ?? "")"
                                                data-card-id="@cardIdStr"
                                                data-category-id="@catIdStr"
                                                data-amount="@amtStr"
                                                data-currency="@s.Currency"
                                                data-frequency="@s.Frequency"
                                                data-start="@startStr"
                                                data-next="@nextStr"
                                                data-notes="@notesAttr"
                                                onclick="openEditSub(this)">
                                            ✏️
                                        </button>
                                        <!-- Toggle pause/activate -->
                                        @if (s.Status != "cancelada")
                                        {
                                            <form method="post" action="/subscriptions/toggle/@s.SubscriptionId" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(s.Status == "activa" ? "btn-outline-warning" : "btn-outline-success")"
                                                        title="@(s.Status == "activa" ? "Pausar" : "Reactivar")">
                                                    @(s.Status == "activa" ? "⏸" : "▶")
                                                </button>
                                            </form>
                                            <form method="post" action="/subscriptions/cancel/@s.SubscriptionId" style="display:inline"
                                                  onsubmit="return confirm('¿Cancelar la suscripción @s.Name?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar">✕</button>
                                            </form>
                                        }
                                        <!-- Delete -->
                                        <form method="post" action="/subscriptions/delete/@s.SubscriptionId" style="display:inline"
                                              onsubmit="return confirm('¿Eliminar la suscripción @s.Name? Esta acción no se puede deshacer.')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
    </div>
}
else
{
    <div class="card">
        <div class="empty">
                <div class="empty__icon">🔄</div>
                <p class="empty__title">
                    @(tab == "pausadas" ? "No hay suscripciones pausadas" :
                      tab == "canceladas" ? "No hay suscripciones canceladas" :
                      "No hay suscripciones activas")
                </p>
                @if (tab == "activas" || tab == "")
                {
                    <p class="empty__text">Registra tus suscripciones recurrentes (Netflix, Spotify, gimnasio…)</p>
                    <button class="btn btn--primary btn--sm mt-2" data-bs-toggle="modal" data-bs-target="#addSubModal">
                        <i data-lucide="plus" style="width:16px;height:16px"></i> Nueva Suscripción
                    </button>
                }
        </div>
    </div>
}

<!-- ── Add Subscription Modal ────────────────────────────────────────────── -->
<div class="modal fade" id="addSubModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">➕ Nueva Suscripción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/subscriptions/add">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre *</label>
                            <input name="Name" class="form-control" placeholder="Netflix, Spotify, Gimnasio…" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Comercio / Proveedor</label>
                            <input name="Merchant" class="form-control" placeholder="Netflix Inc." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Monto *</label>
                            <input name="Amount" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Moneda</label>
                            <select name="Currency" class="form-select">
                                <option value="CRC">CRC ₡</option>
                                <option value="USD">USD $</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Frecuencia</label>
                            <select name="Frequency" class="form-select">
                                <option value="mensual">Mensual</option>
                                <option value="anual">Anual</option>
                                <option value="trimestral">Trimestral</option>
                                <option value="semanal">Semanal</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha de inicio</label>
                            <input name="StartDate" type="date" class="form-control"
                                   value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Próxima renovación *</label>
                            <input name="NextBillingDate" type="date" class="form-control" required
                                   value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tarjeta (opcional)</label>
                            <select name="CardId" class="form-select">
                                <option value="">Sin tarjeta</option>
                                @foreach (var c in Model.Cards)
                                {
                                    <option value="@c.CardId">@c.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Categoría (opcional)</label>
                            <select name="CategoryId" class="form-select">
                                <option value="">Sin categoría</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryId">@cat.IconEmoji @cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Banco / Método de pago</label>
                            <input name="Bank" class="form-control" placeholder="BCR, PayPal, tarjeta…" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notas</label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="Observaciones opcionales…"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Edit Subscription Modal ───────────────────────────────────────────── -->
<div class="modal fade" id="editSubModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">✏️ Editar Suscripción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="editSubForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre *</label>
                            <input name="Name" id="editSubName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Comercio / Proveedor</label>
                            <input name="Merchant" id="editSubMerchant" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Monto *</label>
                            <input name="Amount" id="editSubAmount" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Moneda</label>
                            <select name="Currency" id="editSubCurrency" class="form-select">
                                <option value="CRC">CRC ₡</option>
                                <option value="USD">USD $</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Frecuencia</label>
                            <select name="Frequency" id="editSubFrequency" class="form-select">
                                <option value="mensual">Mensual</option>
                                <option value="anual">Anual</option>
                                <option value="trimestral">Trimestral</option>
                                <option value="semanal">Semanal</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha de inicio</label>
                            <input name="StartDate" id="editSubStart" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Próxima renovación *</label>
                            <input name="NextBillingDate" id="editSubNext" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tarjeta (opcional)</label>
                            <select name="CardId" id="editSubCardId" class="form-select">
                                <option value="">Sin tarjeta</option>
                                @foreach (var c in Model.Cards)
                                {
                                    <option value="@c.CardId">@c.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Categoría (opcional)</label>
                            <select name="CategoryId" id="editSubCategoryId" class="form-select">
                                <option value="">Sin categoría</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryId">@cat.IconEmoji @cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Banco / Método de pago</label>
                            <input name="Bank" id="editSubBank" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notas</label>
                            <textarea name="Notes" id="editSubNotes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openEditSub(btn) {
    var d = btn.dataset;
    document.getElementById('editSubForm').action = '/subscriptions/edit/' + d.id;
    document.getElementById('editSubName').value      = d.name      || '';
    document.getElementById('editSubMerchant').value  = d.merchant  || '';
    document.getElementById('editSubBank').value      = d.bank      || '';
    document.getElementById('editSubAmount').value    = d.amount    || '';
    document.getElementById('editSubStart').value     = d.start     || '';
    document.getElementById('editSubNext').value      = d.next      || '';
    document.getElementById('editSubNotes').value     = d.notes     || '';

    var curSel  = document.getElementById('editSubCurrency');
    curSel.value = d.currency || 'CRC';

    var freqSel = document.getElementById('editSubFrequency');
    freqSel.value = d.frequency || 'mensual';

    var cardSel = document.getElementById('editSubCardId');
    cardSel.value = d.cardId || '';

    var catSel  = document.getElementById('editSubCategoryId');
    catSel.value = d.categoryId || '';

    new bootstrap.Modal(document.getElementById('editSubModal')).show();
}
</script>
}
