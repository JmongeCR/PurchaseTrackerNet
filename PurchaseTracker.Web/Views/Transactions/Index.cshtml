            </div>
            <div class="dr-row">
                <div class="dr-row-icon"><i data-lucide="repeat-2" style="width:16px;height:16px"></i></div>
                <div class="dr-row-label">Tipo</div>
                <div class="dr-row-val" id="drType"></div>
            </div>
            <div class="dr-row">
                <div class="dr-row-icon"><i data-lucide="radio" style="width:16px;height:16px"></i></div>
                <div class="dr-row-label">Origen</div>
