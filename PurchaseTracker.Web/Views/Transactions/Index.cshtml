@model TransactionListViewModel
@{
    ViewData["Title"] = "Movimientos";

    var txMapJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Transactions.ToDictionary(t => t.TransactionId, t => new {
            id           = t.TransactionId,
            merchant     = t.Merchant,
            bank         = t.Bank,
            cardName     = t.Card?.DisplayName ?? "",
            cardId       = t.CardId,
            catName      = t.Category?.Name ?? "",
            catColor     = t.Category?.Color ?? "",
            catIcon      = t.Category?.IconEmoji ?? "",
            categoryId   = t.CategoryId,
            amount       = t.Amount,
            currency     = t.Currency,
            date         = t.TransactionDate.ToString("yyyy-MM-dd"),
            time         = t.TransactionDate.ToString("HH:mm"),
            status       = t.Status,
            movementType = t.MovementType,
            origin       = t.Origin,
            description  = t.Description ?? "",
            notes        = t.Notes ?? "",
            reference    = $"#{t.TransactionId}"
        })
    );

    // Group transactions by date for the feed view
    var grouped = Model.Transactions
        .GroupBy(t => t.TransactionDate.Date)
        .OrderByDescending(g => g.Key)
        .ToList();
}

<style>
/* ── Transaction drawer (right panel / bottom sheet) ─── */
#txOverlay {
    position:fixed; inset:0;
    background: var(--surface-overlay);
    backdrop-filter: blur(4px);
    z-index:400; opacity:0;
    transition: opacity var(--dur-base);
    pointer-events:none;
}
#txOverlay.open { opacity:1; pointer-events:all; }

#txDrawer {
    position:fixed; top:0; right:0; bottom:0;
    width: 420px; max-width: 100vw;
    background: var(--surface-card);
    border-left: 1px solid var(--border-default);
    z-index: 401;
    transform: translateX(110%);
    transition: transform var(--dur-slow) var(--ease-out);
    display: flex; flex-direction: column;
    box-shadow: var(--shadow-2xl);
}
#txDrawer.open { transform: translateX(0); }

@@media (max-width: 600px) {
    #txDrawer {
        top: auto; left: 0; right: 0; width: 100%;
        height: 92dvh;
        border-radius: var(--radius-3xl) var(--radius-3xl) 0 0;
        border-left: none;
        border-top: 1px solid var(--border-subtle);
        transform: translateY(110%);
    }
    #txDrawer.open { transform: translateY(0); }
}

/* Drawer internals */
.dr-handle {
    display: none; width: 36px; height: 4px;
    border-radius: var(--radius-full);
    background: var(--neutral-200);
    margin: var(--sp-3) auto var(--sp-1);
}
@@media (max-width: 600px) { .dr-handle { display: block; } }

.dr-head {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-5) var(--sp-3);
    border-bottom: 1px solid var(--border-subtle);
    flex-shrink: 0;
}
.dr-avatar {
    width: 44px; height: 44px; border-radius: var(--radius-xl);
    background: linear-gradient(135deg, var(--brand-500), #6366f1);
    color: white; display: flex; align-items: center; justify-content: center;
    font-size: var(--text-xl); font-weight: 700; flex-shrink: 0;
}
.dr-merchant {
    font-size: var(--text-lg); font-weight: 700;
    color: var(--text-primary); flex: 1; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dr-close {
    width: 32px; height: 32px;
    border-radius: var(--radius-full);
    background: var(--neutral-100); border: none;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    color: var(--text-secondary); flex-shrink: 0;
    transition: background var(--dur-fast);
}
.dr-close:hover { background: var(--neutral-200); }
.dr-body { flex: 1; overflow-y: auto; padding: 0 var(--sp-5) var(--sp-6); overscroll-behavior: contain; }
.dr-amount-block { text-align: center; padding: var(--sp-6) 0 var(--sp-5); border-bottom: 1px solid var(--border-subtle); }
.dr-amount { font-size: var(--text-4xl); font-weight: 800; letter-spacing: -0.03em; color: var(--text-primary); font-variant-numeric: tabular-nums; }
.dr-amount.usd { color: var(--brand-500); }
.dr-datetime { font-size: var(--text-xs); color: var(--text-muted); margin-top: var(--sp-2); }
.dr-rows { padding: var(--sp-4) 0; }
.dr-row {
    display: flex; align-items: center;
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--border-subtle);
    gap: var(--sp-3);
}
.dr-row:last-child { border-bottom: none; }
.dr-row-icon { width: 28px; text-align: center; font-size: 16px; flex-shrink: 0; color: var(--text-muted); }
.dr-row-label {
    font-size: var(--text-2xs); text-transform: uppercase;
    letter-spacing: 0.07em; color: var(--text-disabled);
    font-weight: 700; width: 80px; flex-shrink: 0;
}
.dr-row-val { font-size: var(--text-sm); font-weight: 600; color: var(--text-primary); flex: 1; }
.dr-notes-block {
    background: var(--neutral-50); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl); padding: var(--sp-3) var(--sp-4);
    margin-top: var(--sp-3);
}
.dr-notes-label { font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-disabled); font-weight: 700; margin-bottom: var(--sp-1); }
.dr-notes-text { font-size: var(--text-sm); color: var(--text-secondary); line-height: 1.6; }
.dr-foot {
    padding: var(--sp-3) var(--sp-5);
    border-top: 1px solid var(--border-subtle);
    display: flex; gap: var(--sp-2);
    flex-shrink: 0;
}
.dr-foot .btn { flex: 1; font-size: var(--text-xs); }
.dr-ref { font-size: var(--text-2xs); color: var(--text-disabled); text-align: center; margin-top: var(--sp-2); }

/* Transaction feed (mobile) */
.tx-row { cursor: pointer; }
.hide-mobile { display: none; }
@@media (min-width: 769px) {
    .hide-mobile { display: revert; }
    .show-mobile-only { display: none !important; }
}
</style>

<!-- ═══════════════════════════════════════════════
     TOTALS STRIP
     ═══════════════════════════════════════════════ -->
@if (Model.TotalCrc > 0 || Model.TotalUsd > 0)
{
    <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap;padding:var(--sp-3) 0 var(--sp-1)">
        <div class="kpi" style="flex:1;min-width:140px;padding:var(--sp-3) var(--sp-4)">
            <div class="kpi__label">Total CRC</div>
            <div class="kpi__value" style="font-size:var(--text-xl)">₡ @Model.TotalCrc.ToString("N0")</div>
        </div>
        @if (Model.TotalUsd > 0)
        {
            <div class="kpi" style="flex:1;min-width:140px;padding:var(--sp-3) var(--sp-4)">
                <div class="kpi__label">Total USD</div>
                <div class="kpi__value" style="font-size:var(--text-xl);color:var(--brand-500)">$ @Model.TotalUsd.ToString("N2")</div>
            </div>
        }
        <div class="kpi" style="flex:0 0 auto;padding:var(--sp-3) var(--sp-4)">
            <div class="kpi__label">Cantidad</div>
            <div class="kpi__value" style="font-size:var(--text-xl)">@Model.TotalCount</div>
        </div>
    </div>
}

<!-- ═══════════════════════════════════════════════
     FILTER BAR
     ═══════════════════════════════════════════════ -->
<details class="card" style="margin:var(--sp-4) 0" id="filterDetails">
    <summary style="display:flex;align-items:center;justify-content:space-between;padding:var(--sp-3) var(--sp-5);cursor:pointer;list-style:none;gap:var(--sp-3)">
        <span style="font-size:var(--text-sm);font-weight:700;color:var(--text-primary);display:flex;align-items:center;gap:var(--sp-2)">
            <i data-lucide="filter" style="width:16px;height:16px"></i>
            Filtros
            @{
                var activeFilters = new List<string>();
                if (!string.IsNullOrEmpty(Model.Search)) activeFilters.Add("Búsqueda");
                if (!string.IsNullOrEmpty(Model.Bank)) activeFilters.Add(Model.Bank);
                if (!string.IsNullOrEmpty(Model.Currency)) activeFilters.Add(Model.Currency);
                if (!string.IsNullOrEmpty(Model.MovementType)) activeFilters.Add(Model.MovementType);
                if (!string.IsNullOrEmpty(Model.Status)) activeFilters.Add(Model.Status);
                if (Model.CategoryId.HasValue) activeFilters.Add("Categoría");
                if (Model.CardId.HasValue) activeFilters.Add("Tarjeta");
                if (Model.StartDate.HasValue || Model.EndDate.HasValue) activeFilters.Add("Fechas");
            }
            @if (activeFilters.Any())
            {
                <span class="badge badge--brand">@activeFilters.Count activo(s)</span>
            }
        </span>
        <div style="display:flex;align-items:center;gap:var(--sp-3)">
            @if (activeFilters.Any())
            {
                <a href="/transactions" style="font-size:var(--text-xs);color:var(--danger-600);font-weight:600">Limpiar</a>
            }
            <i data-lucide="chevron-down" style="width:16px;height:16px;color:var(--text-disabled);transition:transform var(--dur-base)" id="filterChevron"></i>
        </div>
    </summary>
    <div style="padding:var(--sp-3) var(--sp-5) var(--sp-5);border-top:1px solid var(--border-subtle)">
        <form method="get" action="/transactions">
            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <div class="field">
                        <label class="field__label">Buscar</label>
                        <input name="search" value="@Model.Search" class="input" placeholder="Comercio o descripción..." />
                    </div>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="field">
                        <label class="field__label">Banco</label>
                        <select name="bank" class="select">
                            <option value="">Todos</option>
                            @foreach (var b in new[] { "BCR", "BAC", "BN", "BNCR", "Davivienda", "Promerica", "Otro" })
                            {
                                <option value="@b" selected="@(Model.Bank == b)">@b</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="field">
                        <label class="field__label">Moneda</label>
                        <select name="currency" class="select">
                            <option value="">Todas</option>
                            <option value="CRC" selected="@(Model.Currency == "CRC")">CRC</option>
                            <option value="USD" selected="@(Model.Currency == "USD")">USD</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="field">
                        <label class="field__label">Tipo</label>
                        <select name="movementType" class="select">
                            <option value="">Todos</option>
                            <option value="compra" selected="@(Model.MovementType == "compra")">Compra</option>
                            <option value="servicio" selected="@(Model.MovementType == "servicio")">Servicio</option>
                            <option value="suscripcion" selected="@(Model.MovementType == "suscripcion")">Suscripción</option>
                            <option value="retiro_cajero" selected="@(Model.MovementType == "retiro_cajero")">Retiro ATM</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="field">
                        <label class="field__label">Estado</label>
                        <select name="status" class="select">
                            <option value="">Todos</option>
                            <option value="Aprobada" selected="@(Model.Status == "Aprobada")">Aprobada</option>
                            <option value="Rechazada" selected="@(Model.Status == "Rechazada")">Rechazada</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="field">
                        <label class="field__label">Categoría</label>
                        <select name="categoryId" class="select">
                            <option value="">Todas</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">@cat.IconEmoji @cat.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="field">
                        <label class="field__label">Tarjeta</label>
                        <select name="cardId" class="select">
                            <option value="">Todas</option>
                            @foreach (var card in Model.Cards)
                            {
                                <option value="@card.CardId" selected="@(Model.CardId == card.CardId)">@card.DisplayName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="field">
                        <label class="field__label">Desde</label>
                        <input name="startDate" type="date" class="input" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="field">
                        <label class="field__label">Hasta</label>
                        <input name="endDate" type="date" class="input" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="field">
                        <label class="field__label">Ordenar</label>
                        <select name="sort" class="select">
                            <option value="date_desc" selected="@(Model.Sort == "date_desc")">Más reciente</option>
                            <option value="date_asc" selected="@(Model.Sort == "date_asc")">Más antiguo</option>
                            <option value="amount_desc" selected="@(Model.Sort == "amount_desc")">Mayor monto</option>
                            <option value="amount_asc" selected="@(Model.Sort == "amount_asc")">Menor monto</option>
                        </select>
                    </div>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn--primary">Aplicar filtros</button>
                    <a href="/transactions" class="btn btn--ghost">Limpiar</a>
                    <a href="@Url.Action("Export", new { Model.Search, Model.Bank, Model.Currency, Model.MovementType, Model.Status, Model.CategoryId, Model.CardId, Model.StartDate, Model.EndDate })"
                       class="btn btn--ghost" style="margin-left:auto">
                        <i data-lucide="download" style="width:14px;height:14px"></i> CSV
                    </a>
                </div>
            </div>
        </form>
    </div>
</details>

<!-- ═══════════════════════════════════════════════
     ACTION BAR
     ═══════════════════════════════════════════════ -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--sp-4);gap:var(--sp-3)">
    <span style="font-size:var(--text-xs);color:var(--text-muted);font-weight:500">
        @Model.TotalCount movimiento(s)
        @if (Model.TotalPages > 1){ <text>· Pág. @Model.Page/@Model.TotalPages</text> }
    </span>
    <button class="btn btn--primary btn--sm" onclick="openAddModal()">
        <i data-lucide="plus" style="width:14px;height:14px"></i> Agregar
    </button>
</div>

<!-- ═══════════════════════════════════════════════
     TRANSACTION LIST
     ═══════════════════════════════════════════════ -->
@if (Model.Transactions.Any())
{
    <!-- Feed view (mobile) / grouped -->
    <div class="show-mobile-only">
        <div class="tx-feed">
            @foreach (var group in grouped)
            {
                var groupTotal = group.Sum(t => t.Amount);
                var groupCurrency = group.Select(t => t.Currency).Distinct().Count() == 1 ? group.First().Currency : "mixed";
                <div class="tx-group">
                    <div class="tx-group__header">
                        <span class="tx-group__date">@group.Key.ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es-CR"))</span>
                        @if (groupCurrency != "mixed")
                        {
                            <span class="tx-group__sum">@(groupCurrency == "CRC" ? "₡" : "$") @groupTotal.ToString("N0")</span>
                        }
                    </div>
                    @foreach (var tx in group)
                    {
                        <div class="tx-item tx-row @(tx.Status == "Rechazada" ? "tx-item--pending" : "")" data-tx-id="@tx.TransactionId">
                            <div class="tx-item__merchant">@(tx.Merchant?.Length > 0 ? tx.Merchant[0].ToString().ToUpper() : "?")</div>
                            <div class="tx-item__info">
                                <div class="tx-item__name">@tx.Merchant</div>
                                <div class="tx-item__meta">
                                    @tx.Bank
                                    @if (tx.Category != null)
                                    {
                                        <span class="tx-item__chip">@tx.Category.IconEmoji @tx.Category.Name</span>
                                    }
                                </div>
                            </div>
                            <div class="tx-item__right">
                                <div class="tx-item__amount @(tx.Currency == "USD" ? "" : "")">
                                    @(tx.Currency == "CRC" ? "₡" : "$") @tx.Amount.ToString("N2")
                                </div>
                                @if (tx.Status == "Rechazada")
                                {
                                    <div style="font-size:var(--text-2xs);color:var(--danger-600);font-weight:600;margin-top:2px">Rechazada</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Table view (desktop) -->
    <div class="hide-mobile">
        <div class="card">
            <div class="card__body" style="padding:0;overflow-x:auto">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="font-size:var(--text-2xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:var(--sp-3) var(--sp-4)">Fecha</th>
                            <th style="font-size:var(--text-2xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:var(--sp-3) var(--sp-4)">Comercio</th>
                            <th style="font-size:var(--text-2xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:var(--sp-3) var(--sp-4)">Banco</th>
                            <th style="font-size:var(--text-2xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:var(--sp-3) var(--sp-4)">Monto</th>
                            <th style="font-size:var(--text-2xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:var(--sp-3) var(--sp-4)">Tipo</th>
                            <th style="font-size:var(--text-2xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:var(--sp-3) var(--sp-4)">Estado</th>
                            <th style="font-size:var(--text-2xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:var(--sp-3) var(--sp-4)">Categoría</th>
                            <th style="font-size:var(--text-2xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:var(--sp-3) var(--sp-4)">Tarjeta</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in Model.Transactions)
                        {
                            <tr class="tx-row" data-tx-id="@tx.TransactionId" style="cursor:pointer">
                                <td style="font-size:var(--text-xs);color:var(--text-muted);white-space:nowrap;padding:var(--sp-3) var(--sp-4)">
                                    @tx.TransactionDate.ToString("dd/MM/yyyy")
                                </td>
                                <td style="padding:var(--sp-3) var(--sp-4)">
                                    <div style="display:flex;align-items:center;gap:var(--sp-2)">
                                        <div style="width:32px;height:32px;border-radius:var(--radius-lg);background:var(--neutral-100);display:flex;align-items:center;justify-content:center;font-size:var(--text-sm);font-weight:700;color:var(--text-secondary);flex-shrink:0">
                                            @(tx.Merchant?.Length > 0 ? tx.Merchant[0].ToString().ToUpper() : "?")
                                        </div>
                                        <div>
                                            <div style="font-size:var(--text-sm);font-weight:600;color:var(--text-primary)">@tx.Merchant</div>
                                            @if (!string.IsNullOrEmpty(tx.Notes))
                                            {
                                                <div style="font-size:var(--text-xs);color:var(--text-muted)">@tx.Notes</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td style="font-size:var(--text-xs);color:var(--text-secondary);padding:var(--sp-3) var(--sp-4)">@tx.Bank</td>
                                <td style="font-size:var(--text-sm);font-weight:700;font-variant-numeric:tabular-nums;padding:var(--sp-3) var(--sp-4);color:@(tx.Currency == "USD" ? "var(--brand-500)" : "var(--text-primary)")">
                                    @(tx.Currency == "CRC" ? "₡" : "$") @tx.Amount.ToString("N0")
                                </td>
                                <td style="font-size:var(--text-xs);padding:var(--sp-3) var(--sp-4)">
                                    @{
                                        var typeLabel = tx.MovementType switch {
                                            "compra" => "🛒 Compra",
                                            "servicio" => "🔧 Servicio",
                                            "suscripcion" => "🔄 Suscripción",
                                            "retiro_cajero" => "🏧 Retiro ATM",
                                            _ => tx.MovementType
                                        };
                                    }
                                    <span style="color:var(--text-muted)">@typeLabel</span>
                                </td>
                                <td style="padding:var(--sp-3) var(--sp-4)">
                                    @if (tx.Status == "Aprobada")
                                    {
                                        <span class="badge badge--success">✓ Aprobada</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge--danger">✗ @tx.Status</span>
                                    }
                                </td>
                                <td style="padding:var(--sp-3) var(--sp-4)">
                                    @if (tx.Category != null)
                                    {
                                        <span class="badge" style="background:@(tx.Category.Color)22;color:@tx.Category.Color;border:1px solid @(tx.Category.Color)33">
                                            @tx.Category.IconEmoji @tx.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="btn btn--ghost btn--sm assign-cat-btn"
                                                data-tx-id="@tx.TransactionId"
                                                onclick="event.stopPropagation()">
                                            + Categoría
                                        </button>
                                    }
                                </td>
                                <td style="font-size:var(--text-xs);color:var(--text-muted);padding:var(--sp-3) var(--sp-4)">
                                    @(tx.Card?.DisplayName ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div style="padding:var(--sp-3) var(--sp-5);border-top:1px solid var(--border-subtle);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--sp-3)">
                    <span style="font-size:var(--text-xs);color:var(--text-muted)">Página @Model.Page de @Model.TotalPages · @Model.TotalCount registros</span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @if (Model.Page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(Model.Page-1)&search=@Model.Search&bank=@Model.Bank&currency=@Model.Currency&sort=@Model.Sort&startDate=@Model.StartDate?.ToString("yyyy-MM-dd")&endDate=@Model.EndDate?.ToString("yyyy-MM-dd")">‹</a>
                                </li>
                            }
                            @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" href="?page=@i&search=@Model.Search&bank=@Model.Bank&currency=@Model.Currency&sort=@Model.Sort&startDate=@Model.StartDate?.ToString("yyyy-MM-dd")&endDate=@Model.EndDate?.ToString("yyyy-MM-dd")">@i</a>
                                </li>
                            }
                            @if (Model.Page < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(Model.Page+1)&search=@Model.Search&bank=@Model.Bank&currency=@Model.Currency&sort=@Model.Sort&startDate=@Model.StartDate?.ToString("yyyy-MM-dd")&endDate=@Model.EndDate?.ToString("yyyy-MM-dd")">›</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>

    <!-- Mobile pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="show-mobile-only" style="display:flex;justify-content:center;gap:var(--sp-2);margin-top:var(--sp-4);padding-bottom:var(--sp-4)">
            @if (Model.Page > 1)
            {
                <a class="btn btn--ghost btn--sm" href="?page=@(Model.Page-1)&search=@Model.Search&bank=@Model.Bank&currency=@Model.Currency&sort=@Model.Sort">‹ Anterior</a>
            }
            <span style="font-size:var(--text-xs);color:var(--text-muted);display:flex;align-items:center;padding:0 var(--sp-2)">@Model.Page / @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn--ghost btn--sm" href="?page=@(Model.Page+1)&search=@Model.Search&bank=@Model.Bank&currency=@Model.Currency&sort=@Model.Sort">Siguiente ›</a>
            }
        </div>
    }
}
else
{
    <div class="empty">
        <div class="empty__icon">💳</div>
        <div class="empty__title">Sin movimientos</div>
        <div class="empty__text">No hay transacciones con los filtros actuales.</div>
        <div style="display:flex;gap:var(--sp-3);margin-top:var(--sp-4)">
            <button class="btn btn--primary" onclick="openAddModal()">Registrar movimiento</button>
            <a href="/transactions" class="btn btn--ghost">Limpiar filtros</a>
        </div>
    </div>
}

<!-- ═══════════════════════════════════════════════
     TRANSACTION DRAWER
