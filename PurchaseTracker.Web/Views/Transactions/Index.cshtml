<div id="txOverlay" onclick="closeDrawer()"></div>
<div id="txDrawer" role="dialog" aria-modal="true" aria-labelledby="drMerchant">
    <div class="dr-handle"></div>
    <div class="dr-head">
        <div class="dr-avatar" id="drAvatar"></div>
        <div class="dr-merchant" id="drMerchant"></div>
        <button class="dr-close" onclick="closeDrawer()" aria-label="Cerrar"><i data-lucide="x"></i></button>
    </div>
    <div class="dr-body">
        <div class="dr-amount-block">
            <div class="dr-amount" id="drAmount"></div>
            <div class="dr-datetime" id="drDatetime"></div>
        </div>
        <div class="dr-rows">
            <div class="dr-row">
                <div class="dr-row-icon"><i data-lucide="landmark" style="width:16px;height:16px"></i></div>
                <div class="dr-row-label">Banco</div>
                <div class="dr-row-val" id="drBank"></div>
            </div>
            <div class="dr-row">
                <div class="dr-row-icon"><i data-lucide="credit-card" style="width:16px;height:16px"></i></div>
