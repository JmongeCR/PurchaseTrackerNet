                                <div class="row g-3">
                                    <div class="col-4">
                                        <label class="form-label">Límite</label>
                                        <input name="CreditLimit" id="addCreditLimit" type="number"
                                               step="0.01" min="0" class="form-control" placeholder="0.00" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label">Día de corte</label>
                                        <input name="CutDay" id="addCutDay" type="number"
                                               min="1" max="31" class="form-control" placeholder="15" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label">Días para pago</label>
                                        <input name="PaymentDays" id="addPayDays" type="number"
                                               min="1" class="form-control" placeholder="15" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
