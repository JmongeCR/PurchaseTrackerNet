        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">➕ Nueva Tarjeta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/cards/add">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Banco *</label>
                            <select name="Bank" class="form-select" required>
                                <option value="">Seleccionar</option>
                                @foreach (var b in new[] { "BCR", "BAC", "BN", "BNCR", "Davivienda", "Promerica", "Otro" })
                                {
                                    <option value="@b">@b</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Tipo</label>
                            <select name="CardType" id="addCardType" class="form-select"
                                    onchange="toggleCreditFields('add')">
                                <option value="credito">Crédito</option>
                                <option value="debito">Débito</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Alias</label>
                            <input name="CardAlias" class="form-control" placeholder="Mi VISA oro" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Últimos 4 dígitos</label>
                            <input name="Last4" class="form-control" maxlength="4" placeholder="1234" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Moneda</label>
                            <select name="Currency" class="form-select">
                                <option value="CRC">CRC</option>
                                <option value="USD">USD</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Marca</label>
                            <select name="CardBrand" class="form-select">
                                <option value="">Sin marca</option>
                                <option value="Visa">Visa</option>
                                <option value="Mastercard">Mastercard</option>
                                <option value="Amex">American Express</option>
                                <option value="EFTPOS">EFTPOS</option>
                                <option value="Dinero">Dinero</option>
                            </select>
                        </div>
                        <!-- Campos solo para crédito -->
                        <div class="col-12" id="addCreditFields">
                            <div class="p-3 rounded" style="background:#f8fafc;border:1px solid #e2e8f0">
                                <div style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px">
                                    Solo tarjeta de crédito
