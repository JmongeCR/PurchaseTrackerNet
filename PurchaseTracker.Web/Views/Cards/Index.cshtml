@section Scripts {
<script>
// ── Campos condicionales crédito/débito ──────────────────────────────────────
function toggleCreditFields(prefix) {
    var typeVal = document.getElementById(prefix + 'CardType').value;
    var fieldsDiv = document.getElementById(prefix + 'CreditFields');
    var isCredit = typeVal === 'credito';

    fieldsDiv.style.display = isCredit ? '' : 'none';

    // Deshabilitar inputs para que no se envíen ni validen
    fieldsDiv.querySelectorAll('input').forEach(function(el) {
        el.disabled = !isCredit;
        if (!isCredit) el.value = '';   // limpiar al cambiar a débito
    });
}

// Inicializar al cargar la página
document.addEventListener('DOMContentLoaded', function() {
    toggleCreditFields('add');

    // Re-evaluar al abrir el modal de agregar
    document.getElementById('addCardModal').addEventListener('show.bs.modal', function() {
        toggleCreditFields('add');
    });
});

// ── Abrir modal de edición ───────────────────────────────────────────────────
function openEditCard(id, bank, alias, last4, type, currency, cutDay, payDays, limit, brand) {
    document.getElementById('editCardForm').action = '/cards/' + id + '/edit';

    // Banco
    var bankSel = document.getElementById('editBank');
    for (var i = 0; i < bankSel.options.length; i++) {
        if (bankSel.options[i].value === bank) { bankSel.selectedIndex = i; break; }
    }

    // Alias y last4
    document.getElementById('editAlias').value  = alias  || '';
    document.getElementById('editLast4').value  = last4  || '';

    // Tipo
    var typeSel = document.getElementById('editCardType');
    for (var i = 0; i < typeSel.options.length; i++) {
        if (typeSel.options[i].value === type) { typeSel.selectedIndex = i; break; }
    }

    // Moneda
    var curSel = document.getElementById('editCurrency');
    for (var i = 0; i < curSel.options.length; i++) {
        if (curSel.options[i].value === currency) { curSel.selectedIndex = i; break; }
    }

    // Marca
    var brandSel = document.getElementById('editCardBrand');
    brandSel.value = brand || '';

    // Campos de crédito
    document.getElementById('editCutDay').value  = cutDay  != null ? cutDay  : '';
    document.getElementById('editPayDays').value = payDays != null ? payDays : '';
    document.getElementById('editLimit').value   = limit   != null ? limit   : '';

    // Aplicar visibilidad según tipo
    toggleCreditFields('edit');

    new bootstrap.Modal(document.getElementById('editCardModal')).show();
}
</script>
}
