@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión — PurchaseTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; font-family: 'Inter', system-ui, -apple-system, sans-serif; background: #f1f5f9; }
        .login-page { min-height: 100vh; display: flex; }
        .login-left {
            width: 45%; background: #0f172a;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; padding: 48px;
        }
        .login-right {
            flex: 1; display: flex;
            align-items: center; justify-content: center; padding: 48px;
        }
        .login-form-card { width: 100%; max-width: 420px; }
        .brand-icon {
            width: 72px; height: 72px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 18px; display: flex;
            align-items: center; justify-content: center;
            color: white; font-size: 28px; font-weight: 800;
            box-shadow: 0 8px 24px rgba(59,130,246,0.4);
        }
        .form-control, .form-select {
            border-radius: 8px; border: 1.5px solid #e2e8f0;
            font-size: 14px; padding: 10px 14px;
            transition: border-color .15s, box-shadow .15s;
        }
        .form-control:focus, .form-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,.12);
            outline: none;
        }
        .form-label { font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 5px; display: block; }
        .btn-login {
            background: #3b82f6; color: white; border: none;
            border-radius: 8px; padding: 12px; font-size: 15px;
            font-weight: 600; cursor: pointer; width: 100%;
            transition: background .15s, transform .1s;
        }
        .btn-login:hover { background: #2563eb; transform: translateY(-1px); }
        .feature-item { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,.65); font-size: 13px; }
        @@media (max-width: 768px) {
            .login-left { display: none; }
            .login-right { padding: 24px; }
        }
    </style>
</head>
<body>
<div class="login-page">
    <!-- Left panel -->
    <div class="login-left">
        <div class="text-center">
            <div class="brand-icon mx-auto mb-4">PT</div>
            <h1 style="color:white;font-size:28px;font-weight:700;margin-bottom:12px">PurchaseTracker</h1>
            <p style="color:rgba(255,255,255,.5);font-size:15px;max-width:300px;line-height:1.7;margin:0 auto">
                Control financiero inteligente. Gestiona gastos, tarjetas y categorías desde un solo lugar.
            </p>
            <div class="mt-5 d-flex flex-column gap-3">
                <div class="feature-item">
                    <span style="font-size:20px">💳</span>
                    <span>Seguimiento de transacciones manual</span>
                </div>
                <div class="feature-item">
                    <span style="font-size:20px">📊</span>
                    <span>Dashboard con estadísticas en tiempo real</span>
                </div>
                <div class="feature-item">
                    <span style="font-size:20px">🏦</span>
                    <span>Gestión de tarjetas y ciclos de crédito</span>
                </div>
                <div class="feature-item">
                    <span style="font-size:20px">🏷️</span>
                    <span>Categorías personalizadas</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right panel -->
    <div class="login-right">
        <div class="login-form-card">
            <div class="text-center mb-5 d-md-none">
                <div class="brand-icon mx-auto mb-3" style="width:56px;height:56px;font-size:22px;border-radius:14px">PT</div>
            </div>

            <h2 style="font-size:24px;font-weight:700;color:#0f172a;margin-bottom:6px">Bienvenido de vuelta</h2>
            <p style="color:#64748b;font-size:14px;margin-bottom:28px">Ingresa tus credenciales para continuar</p>

            <form asp-action="Login" asp-controller="Auth" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="font-size:13px;display:@(ViewContext.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Email" class="form-control" placeholder="tu@correo.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:12px"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <div class="position-relative">
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••"
                               autocomplete="current-password" id="passwordInput" />
                        <button type="button"
                                style="position:absolute;top:50%;right:10px;transform:translateY(-50%);background:none;border:none;color:#94a3b8;padding:4px;cursor:pointer"
                                onclick="togglePassword()">👁️</button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px"></span>
                </div>

                <div class="mb-4 d-flex align-items-center">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label" style="font-size:13.5px;color:#64748b">
                            Recordarme por 7 días
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn-login">Iniciar sesión</button>
            </form>

            <div class="mt-4 text-center">
                <p style="color:#94a3b8;font-size:12px">PurchaseTracker v1.0 — Phase 1</p>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    function togglePassword() {
        const inp = document.getElementById('passwordInput');
        inp.type = inp.type === 'password' ? 'text' : 'password';
    }
</script>
</body>
</html>
