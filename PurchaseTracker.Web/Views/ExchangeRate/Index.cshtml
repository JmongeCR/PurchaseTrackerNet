@model PurchaseTracker.Web.Services.ExchangeRateData
@using System.Globalization
@{
    ViewData["Title"] = "Tipo de Cambio";

    var compraJs = Model.IsError ? "0" : Model.Compra.ToString("F4", CultureInfo.InvariantCulture);
    var ventaJs  = Model.IsError ? "0" : Model.Venta.ToString("F4", CultureInfo.InvariantCulture);
    var updLabel = Model.Updated ?? Model.VentaDate ?? "—";
}

<div class="d-flex align-items-center justify-content-between mb-4 gap-2" style="flex-wrap:wrap">
    <p class="mb-0" style="font-size:var(--text-sm);color:var(--text-secondary)">
        Fuente: BCCR vía GoMeta &middot; Actualizado: @updLabel
    </p>
    <button class="btn btn--outline btn--sm" onclick="location.reload()">
        <i data-lucide="refresh-cw" style="width:14px;height:14px"></i> Actualizar
    </button>
</div>

@if (Model.IsError)
{
    <div class="alert" style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:12px;padding:16px 20px">
        ⚠️ No se pudo obtener el tipo de cambio en este momento. La API de GoMeta no respondió.
        <a href="javascript:location.reload()" style="color:#991b1b;font-weight:600;margin-left:8px">Reintentar →</a>
    </div>
}

<!-- ── KPI cards ─────────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi" style="border-left:4px solid var(--success-500)">
            <span class="kpi__label">📥 Compra (Banco te compra USD)</span>
            <span class="kpi__value" style="color:var(--success-600)">
                @if (Model.IsError) { <span style="color:var(--text-tertiary)">—</span> }
                else { <span>₡ @Model.Compra.ToString("N2")</span> }
            </span>
            <span class="kpi__sub">Por cada dólar que vendés al banco</span>
            @if (!string.IsNullOrWhiteSpace(Model.CompraDate))
            {
                <span style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:2px">@Model.CompraDate</span>
            }
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi" style="border-left:4px solid #818CF8">
            <span class="kpi__label">📤 Venta (Banco te vende USD)</span>
            <span class="kpi__value" style="color:#6366f1">
                @if (Model.IsError) { <span style="color:var(--text-tertiary)">—</span> }
                else { <span>₡ @Model.Venta.ToString("N2")</span> }
            </span>
            <span class="kpi__sub">Por cada dólar que le comprás al banco</span>
            @if (!string.IsNullOrWhiteSpace(Model.VentaDate))
            {
                <span style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:2px">@Model.VentaDate</span>
            }
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi" style="border-left:4px solid var(--brand-400)">
            <span class="kpi__label">↔️ Margen banco (spread)</span>
            <span class="kpi__value" style="color:var(--brand-600)">
                @if (Model.IsError) { <span style="color:var(--text-tertiary)">—</span> }
                else { <span>₡ @((Model.Venta - Model.Compra).ToString("N2"))</span> }
            </span>
            <span class="kpi__sub">Diferencia entre compra y venta</span>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi" style="border-left:4px solid var(--warning-500)">
            <span class="kpi__label">🕐 Última consulta</span>
            <span class="kpi__value" style="color:var(--warning-600)">
                @Model.FetchedAt.ToLocalTime().ToString("HH:mm")
            </span>
            <span class="kpi__sub">@Model.FetchedAt.ToLocalTime().ToString("dd/MM/yyyy") · caché 30 min</span>
        </div>
    </div>
</div>

<!-- ── Conversor ─────────────────────────────────────────────────────────── -->
<div class="row g-4">
    <div class="col-xl-7">
        <div class="card">
            <div class="card__header"><span class="card__title">⇄ Conversor USD / CRC</span></div>
            <div class="card__body" style="padding:var(--sp-6) var(--sp-7)">

                @if (Model.IsError)
                {
                    <div class="empty">
                        <div class="empty__icon">📡</div>
                        <p class="empty__title">Sin datos disponibles</p>
                        <p class="empty__text">No hay tipo de cambio disponible en este momento</p>
                    </div>
                }
                else
                {
                    <!-- Monto de entrada -->
                    <div class="mb-4">
                        <label class="form-label fw-600" style="font-size:13px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em">
                            Monto a convertir
                        </label>
                        <div class="d-flex gap-2 align-items-center">
                            <input id="convAmount"
                                   type="number" min="0" step="0.01"
                                   placeholder="0.00"
                                   class="form-control"
                                   style="font-size:28px;font-weight:700;text-align:right;height:62px;border-radius:12px;font-variant-numeric:tabular-nums"
                                   oninput="calcAll()" />
                            <div style="flex-shrink:0">
                                <select id="convFrom" class="form-select"
                                        style="font-size:16px;font-weight:700;height:62px;border-radius:12px;min-width:90px"
                                        onchange="calcAll()">
                                    <option value="USD">🇺🇸 USD</option>
                                    <option value="CRC">🇨🇷 CRC</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Botón swap -->
                    <div class="text-center mb-4">
                        <button onclick="swapCurrencies()"
                                style="background:var(--bg-elevated);border:1px solid var(--border-strong);border-radius:50%;width:44px;height:44px;font-size:18px;cursor:pointer;transition:all .2s;color:var(--text-secondary)"
                                onmouseover="this.style.background='var(--bg-hover)'"
                                onmouseout="this.style.background='var(--bg-elevated)'"
                                title="Intercambiar monedas">
                            ⇅
                        </button>
                    </div>

                    <!-- Resultado -->
                    <div class="mb-4">
                        <label class="form-label fw-600" style="font-size:13px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em">
                            Resultado
                        </label>
                        <div class="d-flex gap-2 align-items-center">
                            <div id="convResult"
                                 style="flex:1;font-size:28px;font-weight:700;text-align:right;height:62px;border-radius:12px;border:1px solid var(--border-strong);padding:0 18px;display:flex;align-items:center;justify-content:flex-end;background:var(--bg-elevated);color:var(--text-primary);font-variant-numeric:tabular-nums">
                                —
                            </div>
                            <div id="convToLabel"
                                 style="flex-shrink:0;font-size:16px;font-weight:700;background:var(--bg-elevated);border:1px solid var(--border-strong);border-radius:12px;height:62px;min-width:90px;display:flex;align-items:center;justify-content:center;color:var(--text-secondary)">
                                🇨🇷 CRC
                            </div>
                        </div>
                    </div>

                    <!-- Tasa usada -->
                    <div id="convRateNote"
                         style="background:var(--accent-subtle);border:1px solid rgba(99,102,241,.2);border-radius:10px;padding:12px 16px;font-size:13px;color:#818CF8">
                        Ingresa un monto para ver la conversión
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ── Tabla de referencia rápida ───────────────────── -->
    <div class="col-xl-5">
        @if (!Model.IsError)
        {
            <div class="card" style="margin-bottom:var(--sp-4)">
                <div class="card__header"><span class="card__title">📋 Referencia rápida — USD → CRC</span></div>
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>USD</th>
                                <th class="text-end">Compra (recibes)</th>
                                <th class="text-end">Venta (pagas)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var amt in new[] { 1m, 5m, 10m, 20m, 50m, 100m, 200m, 500m, 1000m })
                            {
                                <tr>
                                    <td class="text-money fw-600">$ @amt.ToString("N0")</td>
                                    <td class="text-end text-money" style="color:#10b981">₡ @((amt * Model.Compra).ToString("N0"))</td>
                                    <td class="text-end text-money" style="color:#3b82f6">₡ @((amt * Model.Venta).ToString("N0"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
            </div>

            <div class="card">
                <div class="card__header"><span class="card__title">📋 Referencia rápida — CRC → USD</span></div>
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>CRC</th>
                                <th class="text-end">Compra (recibes)</th>
                                <th class="text-end">Venta (pagas)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var amt in new[] { 1000m, 5000m, 10000m, 25000m, 50000m, 100000m, 250000m, 500000m })
                            {
                                <tr>
                                    <td class="text-money fw-600">₡ @amt.ToString("N0")</td>
                                    <td class="text-end text-money" style="color:#10b981">$ @((amt / Model.Venta).ToString("N2"))</td>
                                    <td class="text-end text-money" style="color:#3b82f6">$ @((amt / Model.Compra).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
(function () {
    var COMPRA = @compraJs;
    var VENTA  = @ventaJs;

    function fmt(n, cur) {
        if (cur === 'CRC')
            return '₡ ' + n.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        return '$ ' + n.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
    }

    window.calcAll = function () {
        var raw  = parseFloat(document.getElementById('convAmount').value);
        var from = document.getElementById('convFrom').value;
        var to   = from === 'USD' ? 'CRC' : 'USD';

        // Etiqueta destino
        document.getElementById('convToLabel').textContent = to === 'CRC' ? '🇨🇷 CRC' : '🇺🇸 USD';

        var resEl  = document.getElementById('convResult');
        var noteEl = document.getElementById('convRateNote');

        if (isNaN(raw) || raw <= 0) {
            resEl.textContent = '—';
            noteEl.innerHTML  = 'Ingresa un monto para ver la conversión';
            noteEl.style.background  = 'rgba(99,102,241,0.12)';
            noteEl.style.borderColor = 'rgba(99,102,241,.2)';
            noteEl.style.color       = '#818CF8';
            return;
        }

        var result, tasa, tasaNombre;
        if (from === 'USD') {
            // USD → CRC: usa tasa de VENTA (el banco te vende el dólar)
            tasa      = VENTA;
            tasaNombre = 'Venta';
            result    = raw * VENTA;
        } else {
            // CRC → USD: usa tasa de COMPRA (el banco te compra el colón)
            tasa      = COMPRA;
            tasaNombre = 'Compra';
            result    = raw / COMPRA;
        }

        resEl.textContent = fmt(result, to);

        var urgency = from === 'USD'
            ? '📤 Usando tasa de <strong>' + tasaNombre + '</strong> (₡' + tasa.toLocaleString('es-CR', {minimumFractionDigits:2}) + ') — lo que el banco cobra por el dólar'
            : '📥 Usando tasa de <strong>' + tasaNombre + '</strong> (₡' + tasa.toLocaleString('es-CR', {minimumFractionDigits:2}) + ') — lo que el banco paga por el colón';
        noteEl.innerHTML  = urgency;
        noteEl.style.background  = from === 'USD' ? 'rgba(99,102,241,0.12)' : 'rgba(16,185,129,0.12)';
        noteEl.style.borderColor = from === 'USD' ? 'rgba(99,102,241,.2)'   : 'rgba(16,185,129,.2)';
        noteEl.style.color       = from === 'USD' ? '#818CF8'                : '#34D399';
    };

    window.swapCurrencies = function () {
        var sel = document.getElementById('convFrom');
        sel.value = sel.value === 'USD' ? 'CRC' : 'USD';
        calcAll();
    };
})();
</script>
}
