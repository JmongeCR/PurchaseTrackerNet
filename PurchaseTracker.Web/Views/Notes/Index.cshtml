@model NoteListViewModel
@{
    ViewData["Title"] = "Notas Personales";

    IEnumerable<PersonalNote> FilteredNotes() => Model.Tab switch
    {
        "cobrar" => Model.Notes.Where(n => n.Direction == "cobrar"),
        "pagar"  => Model.Notes.Where(n => n.Direction == "pagar"),
        "pagados" => Model.Notes.Where(n => n.Status == "pagado"),
        _ => Model.Notes
    };
}

<div class="d-flex justify-content-end mb-4">
    <button class="btn btn--primary btn--sm" data-bs-toggle="modal" data-bs-target="#addNoteModal">
        <i data-lucide="plus" style="width:16px;height:16px"></i> Nueva nota
    </button>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="kpi" style="border-left:4px solid var(--success-500)">
            <span class="kpi__label">📥 Por cobrar</span>
            <span class="kpi__value" style="color:var(--success-600)">₡ @Model.TotalToCollect.ToString("N0")</span>
            <span class="kpi__sub">Pendiente de recibir</span>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="kpi" style="border-left:4px solid var(--danger-500)">
            <span class="kpi__label">📤 Por pagar</span>
            <span class="kpi__value" style="color:var(--danger-600)">₡ @Model.TotalToPay.ToString("N0")</span>
            <span class="kpi__sub">Pendiente de pagar</span>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="kpi" style="border-left:4px solid var(--warning-500)">
            <span class="kpi__label">⏳ Pendientes</span>
            <span class="kpi__value" style="color:var(--warning-600)">@Model.PendingCount</span>
            <span class="kpi__sub">Notas sin resolver</span>
        </div>
    </div>
</div>

@{
    // Serialize all notes to JSON for client-side person filtering
    var notesJson = System.Text.Json.JsonSerializer.Serialize(Model.Notes.Select(n => new {
        noteId    = n.NoteId,
        title     = n.Title,
        person    = n.Person ?? "",
        direction = n.Direction,
        amount    = n.Amount,
        paidAmount= n.PaidAmount,
        pendingAmount = n.PendingAmount,
        currency  = n.Currency,
        status    = n.Status,
        noteDate  = n.NoteDate.ToString("dd/MM/yyyy"),
        category  = n.Category != null ? n.Category.Name : "",
        catColor  = n.Category != null ? n.Category.Color : "",
        catIcon   = n.Category != null ? n.Category.IconEmoji : ""
    }));
}

<style>
.np-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex-shrink:0}
#personPanel{display:none;border-left:3px solid var(--accent);background:var(--bg-elevated);border-radius:0 var(--radius-lg) var(--radius-lg) 0;padding:16px 20px;margin-bottom:16px}
.pp-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.pp-title{font-size:15px;font-weight:700;color:var(--text-primary);display:flex;align-items:center;gap:8px}
.pp-note-row{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}
.pp-note-row:last-child{border-bottom:none}
.pp-dir-badge{padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap;border:1px solid}
.pp-collect-badge{background:rgba(16,185,129,0.12);color:#34D399;border-color:rgba(16,185,129,.2)}
.pp-pay-badge{background:rgba(239,68,68,0.12);color:#F87171;border-color:rgba(239,68,68,.2)}
.pp-status{padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600;border:1px solid}
.pp-st-pendiente{background:rgba(99,102,241,0.12);color:#818CF8;border-color:rgba(99,102,241,.2)}
.pp-st-parcial{background:rgba(245,158,11,0.12);color:#FCD34D;border-color:rgba(245,158,11,.2)}
.pp-st-pagado{background:rgba(16,185,129,0.12);color:#34D399;border-color:rgba(16,185,129,.2)}
</style>

<!-- Person Summary -->
@if (Model.PersonSummaries.Any())
{
    <div class="card" style="margin-bottom:var(--sp-3)">
        <div class="card__header"><span class="card__title">👥 Resumen por persona</span></div>
        <div class="card__body">
            <div class="d-flex align-items-center gap-3">
                <select id="personSelect" class="form-select" style="max-width:280px" onchange="onPersonChange(this.value)">
                    <option value="">— Seleccionar persona —</option>
                    @foreach (var p in Model.PersonSummaries)
                    {
                        <option value="@p.Person">@p.Person (@p.Count nota(s))</option>
                    }
                </select>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearPerson()" id="clearBtn" style="display:none">✕ Limpiar</button>
            </div>
        </div>
    </div>

    <!-- Person Detail Panel -->
    <div id="personPanel">
        <div class="pp-header">
            <div class="pp-title">
                <span id="ppAvatar" class="np-avatar" style="width:32px;height:32px;font-size:13px"></span>
                <span id="ppName"></span>
            </div>
            <div id="ppTotals" style="font-size:12px;display:flex;gap:16px"></div>
        </div>
        <div id="ppNotesList"></div>
    </div>
}

<!-- Tabs -->
<div style="display:flex;gap:var(--sp-1);background:var(--neutral-100);border-radius:var(--radius-xl);padding:var(--sp-1);margin-bottom:var(--sp-4);width:fit-content;flex-wrap:wrap">
    @{
        var noteTabItems = new[] {
            ("todos",    "Todos",       Model.Notes.Count),
            ("cobrar",   "📥 Por cobrar", Model.Notes.Count(n => n.Direction == "cobrar" && n.Status != "pagado")),
            ("pagar",    "📤 Por pagar",  Model.Notes.Count(n => n.Direction == "pagar"  && n.Status != "pagado")),
            ("pagados",  "✅ Pagados",    Model.Notes.Count(n => n.Status == "pagado"))
        };
    }
    @foreach (var t in noteTabItems)
    {
        var isActive = Model.Tab == t.Item1;
        <a href="/notes?tab=@t.Item1"
           style="display:flex;align-items:center;gap:var(--sp-2);padding:var(--sp-2) var(--sp-4);border-radius:var(--radius-lg);font-size:var(--text-sm);font-weight:600;text-decoration:none;transition:all var(--dur-base);@(isActive ? "background:var(--surface-card);color:var(--text-primary);box-shadow:var(--shadow-sm)" : "color:var(--text-muted)")">
            @t.Item2
            <span style="font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;background:@(isActive ? "var(--brand-50)" : "var(--neutral-200)");color:@(isActive ? "var(--brand-600)" : "var(--text-muted)")">@t.Item3</span>
        </a>
    }
</div>

<!-- Notes Table -->
<div class="card">
    @{
        var notes = FilteredNotes().ToList();
    }
    <div class="card__header">
        <span class="card__title">📝 Notas</span>
        <span style="font-size:var(--text-xs);color:var(--text-muted)">@notes.Count nota(s)</span>
    </div>
    @if (!notes.Any())
    {
        <div class="empty">
                <div class="empty__icon">📝</div>
                <p class="empty__title">Sin notas aquí</p>
                <p class="empty__text">
                    @if (Model.Tab == "todos")
                    {
                        <span>Haz clic en <strong>Nueva nota</strong> para registrar un cobro o pago.</span>
                    }
                    else
                    {
                        <span>No hay notas en este filtro.</span>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="tx-feed">
                @foreach (var n in notes)
                {
                    var sym        = n.Currency == "USD" ? "$" : "₡";
                    var isCollect  = n.Direction == "cobrar";
                    var avatarBg   = isCollect ? "rgba(16,185,129,0.15)" : "rgba(239,68,68,0.15)";
                    var avatarColor= isCollect ? "#34D399" : "#F87171";
                    var dirLabel   = isCollect ? "📥 Cobrar" : "📤 Pagar";
                    var dirBg      = isCollect ? "rgba(16,185,129,0.12)" : "rgba(239,68,68,0.12)";
                    var dirBorder  = isCollect ? "rgba(16,185,129,.25)"  : "rgba(239,68,68,.25)";
                    var pendColor  = n.PendingAmount > 0 ? "#F87171" : "#34D399";
                    var nTitleJs   = n.Title.Replace("'", "\\'");
                    var (sBg, sColor, sLabel) = n.Status switch
                    {
                        "pagado"  => ("rgba(16,185,129,0.12)", "#34D399", "Pagado"),
                        "parcial" => ("rgba(245,158,11,0.12)",  "#FCD34D", "Parcial"),
                        _         => ("rgba(99,102,241,0.12)",  "#818CF8", "Pendiente")
                    };

                    <div class="tx-item" style="align-items:flex-start">

                        <!-- Direction avatar -->
                        <div class="tx-item__merchant" style="background:@avatarBg;color:@avatarColor;font-size:1.1rem;flex-shrink:0">
                            @(isCollect ? "📥" : "📤")
                        </div>

                        <!-- Main info -->
                        <div class="tx-item__info">
                            <div class="tx-item__name">@n.Title</div>
                            <div class="tx-item__meta" style="display:flex;flex-wrap:wrap;align-items:center;gap:var(--sp-2);margin-top:2px">
                                <span style="background:@dirBg;color:@(isCollect ? "#34D399" : "#F87171");border:1px solid @dirBorder;padding:1px 8px;border-radius:20px;font-size:10px;font-weight:700">@dirLabel</span>
                                @if (!string.IsNullOrWhiteSpace(n.Person))
                                {
                                    <span>👤 @n.Person</span>
                                }
                                @if (n.Category != null)
                                {
                                    <span class="tx-item__chip" style="background:@(n.Category.Color)22;color:@n.Category.Color">@n.Category.IconEmoji @n.Category.Name</span>
                                }
                                <span style="color:var(--text-disabled)">@n.NoteDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <!-- Status + action buttons -->
                            <div style="display:flex;align-items:center;gap:var(--sp-2);margin-top:var(--sp-2);flex-wrap:wrap">
                                <span style="background:@sBg;color:@sColor;padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700">@sLabel</span>
                                @if (n.Status != "pagado")
                                {
                                    <button class="btn btn--ghost btn--sm" style="padding:2px 10px;font-size:11px;height:auto;color:var(--success-600)"
                                            onclick="openPayNote(@n.NoteId, '@nTitleJs', @n.PendingAmount, '@n.Currency')">
                                        💰 Pagar
                                    </button>
                                }
                                <button class="btn btn--ghost btn--sm" style="padding:2px 8px;font-size:11px;height:auto"
                                        onclick="openEditNote(@n.NoteId,'@nTitleJs','@(n.Description?.Replace("'","\\'") ?? "")','@(n.Person?.Replace("'","\\'") ?? "")',@n.Amount,'@n.Currency','@n.NoteDate.ToString("yyyy-MM-dd")','@n.Direction',@(n.CategoryId?.ToString() ?? "null"),'@(n.Notes?.Replace("'","\\'") ?? "")')">
                                    ✏️
                                </button>
                                <form method="post" action="/notes/delete/@n.NoteId" style="display:inline"
                                      onsubmit="return confirm('¿Eliminar @nTitleJs?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn--ghost btn--sm" style="padding:2px 8px;font-size:11px;height:auto;color:var(--danger-500)">🗑</button>
                                </form>
                            </div>
                        </div>

                        <!-- Amount right -->
                        <div class="tx-item__right" style="text-align:right;flex-shrink:0">
                            <div class="tx-item__amount" style="color:@pendColor">
                                @sym @n.PendingAmount.ToString("N0")
                            </div>
                            <div style="font-size:var(--text-xs);color:var(--text-disabled);margin-top:2px">
                                Total @sym @n.Amount.ToString("N0")
                            </div>
                        </div>

                    </div>
                }
            </div>
        }
</div>

<!-- ── Modal: Add Note ───────────────────────────────────────────────────────── -->
<div class="modal fade" id="addNoteModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">➕ Nueva nota</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/notes/add">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Título *</label>
                            <input name="Title" class="form-control" placeholder="ej. Cena del viernes, Gasolina viaje" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Dirección *</label>
                            <select name="Direction" class="form-select">
                                <option value="cobrar">📥 Por cobrar</option>
                                <option value="pagar">📤 Por pagar</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Monto *</label>
                            <input name="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Moneda</label>
                            <select name="Currency" class="form-select">
                                <option value="CRC">CRC (₡)</option>
                                <option value="USD">USD ($)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha</label>
                            <input name="NoteDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Persona</label>
                            <input name="Person" class="form-control" placeholder="ej. Juan, María" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Categoría</label>
                            <select name="CategoryId" class="form-select">
                                <option value="">— Sin categoría —</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryId">@cat.IconEmoji @cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="Detalles opcionales..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notas internas</label>
                            <textarea name="Notes" class="form-control" rows="1" placeholder="Recordatorio personal..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Registrar nota</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Modal: Register Payment ───────────────────────────────────────────────── -->
<div class="modal fade" id="payNoteModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">💰 Registrar pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="payNoteForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p id="payNoteTitle" style="font-size:13px;color:var(--text-secondary);margin-bottom:12px;font-weight:600"></p>
                    <p id="payNotePending" style="font-size:12px;color:var(--text-muted);margin-bottom:12px"></p>
                    <label class="form-label">Monto a pagar *</label>
                    <input name="PaymentAmount" id="payNoteAmount" type="number" step="0.01" min="0.01"
                           class="form-control" placeholder="0.00" required />
                    <div style="font-size:11px;color:var(--text-muted);margin-top:4px">Puedes registrar pagos parciales.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Registrar pago</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Modal: Edit Note ──────────────────────────────────────────────────────── -->
<div class="modal fade" id="editNoteModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">✏️ Editar nota</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="editNoteForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Título *</label>
                            <input name="Title" id="enTitle" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Dirección *</label>
                            <select name="Direction" id="enDirection" class="form-select">
                                <option value="cobrar">📥 Por cobrar</option>
                                <option value="pagar">📤 Por pagar</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Monto *</label>
                            <input name="Amount" id="enAmount" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Moneda</label>
                            <select name="Currency" id="enCurrency" class="form-select">
                                <option value="CRC">CRC (₡)</option>
                                <option value="USD">USD ($)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha</label>
                            <input name="NoteDate" id="enDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Persona</label>
                            <input name="Person" id="enPerson" class="form-control" placeholder="ej. Juan, María" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Categoría</label>
                            <select name="CategoryId" id="enCategory" class="form-select">
                                <option value="">— Sin categoría —</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryId">@cat.IconEmoji @cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <textarea name="Description" id="enDescription" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notas internas</label>
                            <textarea name="Notes" id="enNotes" class="form-control" rows="1"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const ALL_NOTES = @Html.Raw(notesJson);

function fmt(amount, currency) {
    return (currency === 'USD' ? '$' : '₡') + ' ' + amount.toLocaleString('es-CR', {minimumFractionDigits: 0});
}

function onPersonChange(person) {
    if (!person) { clearPerson(); return; }
    showPersonPanel(person);
    document.getElementById('clearBtn').style.display = '';
}

function showPersonPanel(person) {
    const notes = ALL_NOTES.filter(n => n.person === person);

    document.getElementById('ppAvatar').textContent = person.length > 0 ? person[0].toUpperCase() : '?';
    document.getElementById('ppName').textContent = person;

    // Totals summary
    const toCollect = notes.filter(n => n.direction === 'cobrar').reduce((s, n) => s + n.pendingAmount, 0);
    const toPay     = notes.filter(n => n.direction === 'pagar').reduce((s, n) => s + n.pendingAmount, 0);
    const currency  = notes.length ? notes[0].currency : 'CRC';
    let totalsHtml = '';
    if (toCollect > 0) totalsHtml += `<span style="color:#34D399;font-weight:600">📥 Por cobrar: ${fmt(toCollect, currency)}</span>`;
    if (toPay > 0)     totalsHtml += `<span style="color:#F87171;font-weight:600">📤 Por pagar: ${fmt(toPay, currency)}</span>`;
    document.getElementById('ppTotals').innerHTML = totalsHtml;

    const list = document.getElementById('ppNotesList');
    if (!notes.length) {
        list.innerHTML = '<div style="color:var(--text-muted);font-size:13px">Sin notas para esta persona.</div>';
    } else {
        list.innerHTML = notes.map(n => {
            const dirBadge = n.direction === 'cobrar'
                ? '<span class="pp-dir-badge pp-collect-badge">📥 Cobrar</span>'
                : '<span class="pp-dir-badge pp-pay-badge">📤 Pagar</span>';
            const stClass = n.status === 'pagado' ? 'pp-st-pagado' : n.status === 'parcial' ? 'pp-st-parcial' : 'pp-st-pendiente';
            const stLabel = n.status === 'pagado' ? 'Pagado' : n.status === 'parcial' ? 'Parcial' : 'Pendiente';
            const catHtml = n.category ? `<span style="font-size:10px;color:var(--text-muted);margin-left:6px">${n.catIcon} ${n.category}</span>` : '';
            const pendHtml = n.pendingAmount > 0
                ? `<span style="color:#F87171;font-weight:700;font-size:13px">${fmt(n.pendingAmount, n.currency)}</span>`
                : '<span style="color:#34D399">✅</span>';
            const payBtn = n.status !== 'pagado'
                ? `<button class="btn btn-sm btn-success" onclick="openPayNote(${n.noteId},'${n.title.replace(/'/g,"\\'")}',${n.pendingAmount},'${n.currency}')">💰 Pagar</button>`
                : '';
            return `
            <div class="pp-note-row">
                <div style="flex:1;min-width:0">
                    <div style="font-weight:600;font-size:14px">${n.title}${catHtml}</div>
                    <div style="font-size:11px;color:var(--text-muted)">${n.noteDate}</div>
                </div>
                ${dirBadge}
                <div style="text-align:right;min-width:100px">
                    <div style="font-size:12px;color:var(--text-muted)">${fmt(n.amount, n.currency)}</div>
                    <div>${pendHtml}</div>
                </div>
                <span class="pp-status ${stClass}">${stLabel}</span>
                ${payBtn}
            </div>`;
        }).join('');
    }

    document.getElementById('personPanel').style.display = 'block';
}

function clearPerson() {
    document.getElementById('personSelect').value = '';
    document.getElementById('clearBtn').style.display = 'none';
    document.getElementById('personPanel').style.display = 'none';
}

function openEditNote(noteId, title, description, person, amount, currency, noteDate, direction, categoryId, notes) {
    document.getElementById('editNoteForm').action = '/notes/edit/' + noteId;
    document.getElementById('enTitle').value       = title;
    document.getElementById('enDescription').value = description;
    document.getElementById('enPerson').value      = person;
    document.getElementById('enAmount').value      = amount;
    document.getElementById('enDate').value        = noteDate;
    document.getElementById('enNotes').value       = notes;
    var dirSel = document.getElementById('enDirection');
    for (var o of dirSel.options) o.selected = (o.value === direction);
    var curSel = document.getElementById('enCurrency');
    for (var o of curSel.options) o.selected = (o.value === currency);
    var catSel = document.getElementById('enCategory');
    for (var o of catSel.options) o.selected = (categoryId !== null && o.value == categoryId);
    new bootstrap.Modal(document.getElementById('editNoteModal')).show();
}

function openPayNote(noteId, title, pending, currency) {
    document.getElementById('payNoteForm').action = '/notes/pay/' + noteId;
    document.getElementById('payNoteTitle').textContent = title;
    document.getElementById('payNotePending').textContent = 'Pendiente: ' + (currency === 'USD' ? '$' : '₡') + ' ' + pending.toLocaleString('es-CR', {minimumFractionDigits: 0});
    document.getElementById('payNoteAmount').value = '';
    document.getElementById('payNoteAmount').max = pending;
    new bootstrap.Modal(document.getElementById('payNoteModal')).show();
}
</script>
}
