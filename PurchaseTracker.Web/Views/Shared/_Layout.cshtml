@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="es" id="html-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="antiforgery-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — PurchaseTracker" : "PurchaseTracker")</title>

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PurchaseTracker" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💳</text></svg>" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    var initials = string.Concat(
        (User.Identity?.Name ?? "U")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(w => char.ToUpper(w[0]))
    );
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var isAdmin = User.IsInRole("admin");

    <!-- Sidebar overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebar-overlay" onclick="PT.closeSidebar()"></div>

    <!-- ═══════════════════════════════════════════════════════
         SIDEBAR
         ═══════════════════════════════════════════════════════ -->
    <nav class="sidebar" id="sidebar">

        <div class="sidebar-brand">
            <div class="sidebar-brand__icon">P</div>
            <div>
                <div class="sidebar-brand__name">PurchaseTracker</div>
                <div class="sidebar-brand__sub">Control financiero</div>
            </div>
        </div>

        <div class="sidebar-nav">

        @if (isAdmin)
        {
            <div class="sidebar-section">
                <div class="sidebar-section__label">Sistema</div>
                <a class="sidebar-item @(currentController == "Admin" ? "active" : "")" href="/admin">
                    <span class="sidebar-item__icon"><i data-lucide="shield"></i></span>
                    <span class="sidebar-item__text">Usuarios</span>
                </a>
            </div>
        }
        else
        {
            <div class="sidebar-section">
                <div class="sidebar-section__label">Principal</div>
                <a class="sidebar-item @(currentController == "Dashboard" ? "active" : "")" href="/">
                    <span class="sidebar-item__icon"><i data-lucide="layout-dashboard"></i></span>
                    <span class="sidebar-item__text">Inicio</span>
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-section__label">Finanzas</div>
                <a class="sidebar-item @(currentController == "Transactions" ? "active" : "")" href="/transactions">
                    <span class="sidebar-item__icon"><i data-lucide="arrow-left-right"></i></span>
                    <span class="sidebar-item__text">Movimientos</span>
                </a>
                <a class="sidebar-item @(currentController == "Cards" ? "active" : "")" href="/cards">
                    <span class="sidebar-item__icon"><i data-lucide="credit-card"></i></span>
                    <span class="sidebar-item__text">Tarjetas</span>
                </a>
                <a class="sidebar-item @(currentController == "Financing" ? "active" : "")" href="/financing">
                    <span class="sidebar-item__icon"><i data-lucide="landmark"></i></span>
                    <span class="sidebar-item__text">Financiamientos</span>
                </a>
                <a class="sidebar-item @(currentController == "Notes" ? "active" : "")" href="/notes">
                    <span class="sidebar-item__icon"><i data-lucide="notebook-pen"></i></span>
                    <span class="sidebar-item__text">Notas</span>
                </a>
                <a class="sidebar-item @(currentController == "Subscriptions" ? "active" : "")" href="/subscriptions">
                    <span class="sidebar-item__icon"><i data-lucide="repeat-2"></i></span>
                    <span class="sidebar-item__text">Suscripciones</span>
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-section__label">Análisis</div>
                <a class="sidebar-item @(currentController == "ExchangeRate" ? "active" : "")" href="/exchange">
                    <span class="sidebar-item__icon"><i data-lucide="trending-up"></i></span>
                    <span class="sidebar-item__text">Tipo de Cambio</span>
                </a>
                <a class="sidebar-item @(currentController == "Reports" ? "active" : "")" href="/reports">
                    <span class="sidebar-item__icon"><i data-lucide="bar-chart-2"></i></span>
                    <span class="sidebar-item__text">Reportes</span>
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-section__label">Cuenta</div>
                <a class="sidebar-item @(currentController == "Settings" ? "active" : "")" href="/settings">
                    <span class="sidebar-item__icon"><i data-lucide="settings"></i></span>
                    <span class="sidebar-item__text">Configuración</span>
                </a>
            </div>
        }

        </div>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-user__avatar">@initials</div>
                <div class="sidebar-user__info">
                    <div class="sidebar-user__name">@User.Identity?.Name</div>
                    <div class="sidebar-user__email">@userEmail</div>
                </div>
            </div>
            <form method="post" action="/auth/logout" style="margin-top:var(--sp-2)">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-item" style="width:100%;border:none;background:none;color:var(--danger-600)">
                    <span class="sidebar-item__icon"><i data-lucide="log-out"></i></span>
                    <span class="sidebar-item__text">Cerrar sesión</span>
                </button>
            </form>
        </div>
    </nav>

    <!-- ═══════════════════════════════════════════════════════
         MAIN
         ═══════════════════════════════════════════════════════ -->
    <div class="main" id="main-content">

        <!-- Page header -->
        <header class="page-header">
            <div style="display:flex;align-items:center;gap:var(--sp-3)">
                <button class="sidebar-toggle btn btn--icon" id="sidebar-toggle" aria-label="Menú" onclick="PT.toggleSidebar()">
                    <i data-lucide="menu"></i>
                </button>
                <span class="page-header__title">@(ViewData["Title"] ?? "Inicio")</span>
            </div>
            <div class="page-header__actions">
                @if (!isAdmin)
                {
                    @await Component.InvokeAsync("ExchangeRate")
                }
                <button class="btn btn--icon btn--ghost theme-toggle" data-dark-toggle
                        onclick="PT.toggleDarkMode()" aria-label="Cambiar tema" title="Modo oscuro">
                    <i data-lucide="sun" class="theme-toggle__sun"></i>
                    <i data-lucide="moon" class="theme-toggle__moon"></i>
                </button>
                <div style="display:flex;align-items:center;gap:var(--sp-2)">
                    <div class="sidebar-user__avatar" style="width:32px;height:32px;font-size:var(--text-xs)">@initials</div>
                </div>
            </div>
        </header>

        <!-- Flash messages -->
        @if (TempData["Success"] != null)
        {
            <div class="flash flash--success animate-fade-in" role="status">
                <i data-lucide="check-circle"></i>
                <span>@TempData["Success"]</span>
                <button class="flash__close" onclick="this.closest('.flash').remove()" aria-label="Cerrar">
                    <i data-lucide="x"></i>
                </button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="flash flash--error animate-fade-in" role="alert">
                <i data-lucide="alert-circle"></i>
                <span>@TempData["Error"]</span>
                <button class="flash__close" onclick="this.closest('.flash').remove()" aria-label="Cerrar">
                    <i data-lucide="x"></i>
                </button>
            </div>
        }

        <!-- Page body -->
        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         BOTTOM NAV (mobile)
         ═══════════════════════════════════════════════════════ -->
    @if (!isAdmin)
    {
        <nav class="bottom-nav" aria-label="Navegación principal">
            <div class="bottom-nav__inner">
                <a class="bottom-nav__item" href="/" data-href="/">
                    <span class="bottom-nav__icon"><i data-lucide="layout-dashboard"></i></span>
                    <span class="bottom-nav__label">Inicio</span>
                </a>
                <a class="bottom-nav__item" href="/transactions" data-href="/transactions">
                    <span class="bottom-nav__icon"><i data-lucide="arrow-left-right"></i></span>
                    <span class="bottom-nav__label">Movimientos</span>
                </a>

                <!-- Center FAB -->
                <div class="bottom-nav__item" style="pointer-events:none">
                    <button class="bottom-nav__fab" id="fab-add" aria-label="Agregar movimiento"
                            data-sheet="quick-add-sheet" style="pointer-events:all">
                        <i data-lucide="plus"></i>
                    </button>
                </div>

                <a class="bottom-nav__item" href="/cards" data-href="/cards">
                    <span class="bottom-nav__icon"><i data-lucide="credit-card"></i></span>
                    <span class="bottom-nav__label">Tarjetas</span>
                </a>
                <a class="bottom-nav__item" href="/settings" data-href="/settings">
                    <span class="bottom-nav__icon"><i data-lucide="settings"></i></span>
                    <span class="bottom-nav__label">Ajustes</span>
                </a>
            </div>
        </nav>

        <!-- ═══════════════════════════════════════════════════
             QUICK-ADD BOTTOM SHEET
             ═══════════════════════════════════════════════════ -->
        <div class="sheet-backdrop" id="quick-add-sheet-backdrop"></div>
        <div class="sheet" id="quick-add-sheet" role="dialog" aria-modal="true" aria-labelledby="quick-add-title">
            <div class="sheet__handle"></div>
            <div class="sheet__header">
                <span class="sheet__title" id="quick-add-title">Nuevo movimiento</span>
                <button class="sheet__close" data-sheet-close aria-label="Cerrar">
                    <i data-lucide="x"></i>
                </button>
            </div>
            <div class="sheet__body" style="padding:0">

                <!-- Amount display -->
                <div style="padding:var(--sp-4) var(--sp-5) var(--sp-2);text-align:center">
                    <div id="qa-amount-display"
                         style="font-size:2.5rem;font-weight:700;letter-spacing:-0.02em;color:var(--text-primary);min-height:3.5rem;line-height:1">
                        0
                    </div>
                </div>

                <!-- Currency toggle -->
                <div style="display:flex;justify-content:center;gap:var(--sp-2);margin-bottom:var(--sp-3)">
                    <button type="button" class="currency-toggle__option btn btn--sm btn--primary"
                            data-currency="CRC" style="min-width:64px;font-weight:600">₡ CRC</button>
                    <button type="button" class="currency-toggle__option btn btn--sm btn--ghost"
                            data-currency="USD" style="min-width:64px;font-weight:600">$ USD</button>
                </div>

                <!-- Type selector -->
                <div style="display:flex;justify-content:center;gap:var(--sp-2);margin-bottom:var(--sp-4)">
                    <button type="button" class="qa-type-pill btn btn--sm btn--primary" data-type="expense">Gasto</button>
                    <button type="button" class="qa-type-pill btn btn--sm btn--ghost"   data-type="income">Ingreso</button>
                    <button type="button" class="qa-type-pill btn btn--sm btn--ghost"   data-type="transfer">Transferencia</button>
                </div>

                <!-- Numpad -->
                <div class="numpad" style="padding:0 var(--sp-3) var(--sp-2)">
                    @foreach (var key in new[] { "1","2","3","4","5","6","7","8","9",".","0","⌫" })
                    {
                        <button type="button"
                                class="numpad__key @(key == "⌫" ? "numpad__key--action" : "")"
                                data-key="@(key == "⌫" ? "backspace" : key)">@key</button>
                    }
                </div>

                <!-- Confirm row -->
                <div class="qa-confirm-row" style="padding:var(--sp-3) var(--sp-4) var(--sp-5)">
                    <a href="/transactions/create" class="btn btn--ghost btn--sm" style="flex:0 0 auto">
                        <i data-lucide="sliders-horizontal" style="width:15px;height:15px"></i>
                        Detallado
                    </a>
                    <form id="qa-form" method="get" action="/transactions/create" style="flex:1;display:flex">
                        <input type="hidden" name="amount"   id="qa-amount-input" value="0" />
                        <input type="hidden" name="currency" id="qa-currency-input" value="CRC" />
                        <input type="hidden" name="type"     id="qa-type-input" value="expense" />
                        <button type="submit" class="btn btn--primary" style="width:100%;font-weight:700">
                            Continuar
                            <i data-lucide="arrow-right" style="width:16px;height:16px"></i>
                        </button>
                    </form>
                </div>

            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════
         PWA INSTALL PROMPT
         ═══════════════════════════════════════════════════════ -->
    <div class="install-prompt" id="install-prompt" role="dialog" aria-modal="true">
        <div class="install-prompt__icon">💳</div>
        <div class="install-prompt__title">Instalar PurchaseTracker</div>
        <div class="install-prompt__sub">Agrega la app a tu pantalla de inicio para acceso rápido sin conexión.</div>
        <div class="install-prompt__actions">
            <button class="btn btn--primary btn--sm" data-install-trigger>Instalar ahora</button>
            <button class="btn btn--ghost btn--sm" data-install-dismiss>Ahora no</button>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>

<script>
    // ── Sidebar toggle ────────────────────────────────────────
    PT.toggleSidebar = function() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        sidebar.classList.toggle('open');
        overlay?.classList.toggle('show');
    };
    PT.closeSidebar = function() {
        document.getElementById('sidebar')?.classList.remove('open');
        document.getElementById('sidebar-overlay')?.classList.remove('show');
    };

    // Close sidebar on any nav click (mobile)
    document.querySelectorAll('.sidebar-item').forEach(el => {
        el.addEventListener('click', () => {
            if (window.innerWidth < 768) PT.closeSidebar();
        });
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
<script>lucide.createIcons();</script>
</body>
</html>
