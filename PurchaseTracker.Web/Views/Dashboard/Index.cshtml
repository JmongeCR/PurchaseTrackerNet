@model DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Inicio";
    var now       = DateTime.Now;
    var greeting  = now.Hour < 12 ? "Buenos días" : now.Hour < 19 ? "Buenas tardes" : "Buenas noches";
    var firstName = (User.Identity?.Name ?? "").Split(new[]{' ','@'}, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
    var currSpend = Model.MonthSpendingCrc;
    var prevSpend = Model.PrevMonthSpendingCrc;
    decimal varPct = prevSpend > 0 ? (currSpend - prevSpend) / prevSpend * 100m : 0m;
    var varSign   = varPct >= 0 ? "+" : "";
    var nextPmt   = Model.NextPayments.FirstOrDefault();
    bool hasDailyData = Model.DailySpendingJson != "[]";
    var today     = now.ToString("EEEE, d 'de' MMMM", new System.Globalization.CultureInfo("es-CR"));
}

<!-- ═══════════════════════════════════════════════
     GREETING
     ═══════════════════════════════════════════════ -->
<div class="home-greeting">
    <div class="home-greeting__main">@greeting@if (!string.IsNullOrWhiteSpace(firstName)){<text>, @firstName</text>}</div>
    <div class="home-greeting__date">@Model.CurrentMonthLabel · @Model.MonthTransactionCount movimiento(s)</div>
</div>

<!-- ═══════════════════════════════════════════════
     HERO SPEND CARD
     ═══════════════════════════════════════════════ -->
<div class="home-section" style="padding-bottom:var(--sp-4)">
    <div class="hero-card">
        <div class="hero-card__label">Gasto total · @Model.CurrentMonthLabel</div>
        <div class="hero-card__amount">
            @if (currSpend > 0)
            {
                <span style="font-size:0.55em;vertical-align:super;opacity:.6;font-weight:700">₡</span>@currSpend.ToString("N0")
            }
            else if (Model.MonthSpendingUsd > 0)
            {
                <span style="font-size:0.55em;vertical-align:super;opacity:.6;font-weight:700">$</span>@Model.MonthSpendingUsd.ToString("N2")
            }
            else
            {
                <span style="opacity:.35;font-size:0.7em">Sin movimientos</span>
            }
        </div>
        <div class="hero-card__meta">
            @if (Model.MonthSpendingUsd > 0 && currSpend > 0)
            {
                <span class="hero-card__pill">+ $ @Model.MonthSpendingUsd.ToString("N2") USD</span>
            }
            @if (prevSpend > 0)
            {
                var pillClass = varPct > 5 ? "hero-card__pill--down" : varPct < -5 ? "hero-card__pill--up" : "";
                <span class="hero-card__pill @pillClass">@varSign@varPct.ToString("N1")% vs. mes anterior</span>
            }
            <span class="hero-card__pill">@Model.MonthTransactionCount tx · @Model.ActiveCardsCount tarjeta(s)</span>
        </div>
        @if (prevSpend > 0 && currSpend > 0)
        {
            var pct = Math.Min((double)(currSpend / prevSpend) * 100.0, 100.0);
            <div class="hero-progress">
                <div class="hero-progress__track">
                    <div class="hero-progress__fill" style="width:@pct.ToString("F0", CultureInfo.InvariantCulture)%"></div>
                </div>
                <div class="hero-progress__labels">
                    <span>₡ 0</span>
                    <span>₡ @prevSpend.ToString("N0") mes anterior</span>
                </div>
            </div>
        }
    </div>
</div>

<!-- ═══════════════════════════════════════════════
     QUICK ACTIONS
     ═══════════════════════════════════════════════ -->
<div class="home-section" style="padding-bottom:var(--sp-5)">
    <div class="quick-actions">
        <a class="quick-action" href="/transactions/create">
            <div class="quick-action__icon quick-action__icon--brand">
                <i data-lucide="plus"></i>
            </div>
            <span class="quick-action__label">Agregar</span>
        </a>
        <a class="quick-action" href="/transactions">
            <div class="quick-action__icon">
                <i data-lucide="arrow-left-right"></i>
            </div>
            <span class="quick-action__label">Movimientos</span>
        </a>
        <a class="quick-action" href="/cards">
            <div class="quick-action__icon">
                <i data-lucide="credit-card"></i>
            </div>
            <span class="quick-action__label">Tarjetas</span>
        </a>
        <a class="quick-action" href="/exchange">
            <div class="quick-action__icon">
                <i data-lucide="trending-up"></i>
            </div>
            <span class="quick-action__label">Cambio</span>
        </a>
    </div>
</div>

<!-- ═══════════════════════════════════════════════
     KPI STRIP
     ═══════════════════════════════════════════════ -->
<div class="home-section" style="padding-bottom:var(--sp-5)">
    <div class="grid-2" style="gap:var(--sp-3)">

        <!-- Cuotas activas -->
        <div class="kpi">
            <div class="kpi__label"><i data-lucide="landmark" style="width:12px;height:12px;display:inline"></i> Cuotas</div>
            @if (Model.TotalMonthlyCommitment > 0)
            {
                <div class="kpi__value" style="color:var(--brand-500)">₡ @Model.TotalMonthlyCommitment.ToString("N0")</div>
                <div class="kpi__sub">@Model.ActiveFinancingsCount financiamiento(s)</div>
            }
            else
            {
                <div class="kpi__value" style="color:var(--text-disabled)">₡ 0</div>
                <div class="kpi__sub">Sin cuotas activas</div>
            }
        </div>

        <!-- Próximo pago -->
        <div class="kpi">
            <div class="kpi__label"><i data-lucide="calendar" style="width:12px;height:12px;display:inline"></i> Próximo pago</div>
            @if (nextPmt != null)
            {
                var d = nextPmt.DaysUntil;
                var vc = d <= 3 ? "var(--danger-600)" : d <= 7 ? "var(--warning-600)" : "var(--text-primary)";
                <div class="kpi__value" style="font-size:var(--text-base);color:@vc">@nextPmt.Name</div>
                <div class="kpi__sub">
                    @(nextPmt.Currency == "USD" ? "$" : "₡") @nextPmt.Amount.ToString("N2") ·
                    <span style="color:@vc;font-weight:600">@(d <= 0 ? "Vencido" : d == 1 ? "Mañana" : $"en {d}d")</span>
                </div>
            }
            else
            {
                <div class="kpi__value" style="color:var(--success-600)">Al día</div>
                <div class="kpi__sub">Sin vencimientos próximos</div>
            }
        </div>

        <!-- Suscripciones -->
        <div class="kpi">
            <div class="kpi__label"><i data-lucide="repeat-2" style="width:12px;height:12px;display:inline"></i> Suscripciones</div>
            <div class="kpi__value">@Model.ActiveSubscriptionsCount</div>
            @if (Model.TotalMonthlySubscriptionsCrc > 0)
            {
                <div class="kpi__sub">₡ @Model.TotalMonthlySubscriptionsCrc.ToString("N0") / mes</div>
            }
            else
            {
                <div class="kpi__sub">activas este mes</div>
            }
        </div>

        <!-- Variación -->
        <div class="kpi">
            <div class="kpi__label"><i data-lucide="bar-chart-2" style="width:12px;height:12px;display:inline"></i> vs. mes anterior</div>
            @if (prevSpend > 0)
            {
                var trendCls = varPct > 0 ? "kpi__trend--down" : "kpi__trend--up";
                <div class="kpi__value @trendCls">@varSign@varPct.ToString("N1")%</div>
                <div class="kpi__sub">₡ @prevSpend.ToString("N0") anterior</div>
            }
            else
            {
                <div class="kpi__value" style="color:var(--text-disabled)">—</div>
                <div class="kpi__sub">Sin datos previos</div>
            }
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════
     DAILY CHART + CATEGORIES
     ═══════════════════════════════════════════════ -->
<div class="home-section" style="padding-bottom:var(--sp-5)">
    <div class="home-section__header">
        <span class="home-section__title">Análisis · @Model.CurrentMonthLabel</span>
    </div>

    <div class="card" style="margin-bottom:var(--sp-3)">
        <div class="card__header">
            <span class="card__title">Gasto diario (CRC)</span>
        </div>
        <div class="card__body">
            @if (hasDailyData)
            {
                <div style="height:180px;position:relative">
                    <canvas id="dailyChart"></canvas>
                </div>
            }
            else
            {
                <div class="empty" style="padding:var(--sp-8) var(--sp-4)">
                    <div class="empty__icon">📊</div>
                    <div class="empty__title" style="font-size:var(--text-sm)">Sin movimientos CRC</div>
                </div>
            }
        </div>
    </div>

    @if (Model.SpendingByCategory.Any())
    {
        var catMax = Model.SpendingByCategory.Max(c => c.Total);
        <div class="card">
            <div class="card__header">
                <span class="card__title">Por categoría</span>
                <a class="card__action" href="/transactions">Ver todo</a>
            </div>
            <div>
                @foreach (var cat in Model.SpendingByCategory)
                {
                    var pct = catMax > 0 ? (double)(cat.Total / catMax) * 100.0 : 0;
                    <div style="display:flex;align-items:center;gap:var(--sp-3);padding:var(--sp-3) var(--sp-5);border-bottom:1px solid var(--border-subtle)">
                        <div style="width:8px;height:8px;border-radius:50%;flex-shrink:0;background:@cat.Color"></div>
                        <span style="font-size:1rem;line-height:1">@cat.Icon</span>
                        <span style="flex:1;font-size:var(--text-sm);color:var(--text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@cat.CategoryName</span>
                        <div style="width:56px;height:4px;background:var(--border-default);border-radius:var(--radius-full);flex-shrink:0">
                            <div style="height:4px;border-radius:var(--radius-full);background:@cat.Color;width:@pct.ToString("F0", CultureInfo.InvariantCulture)%"></div>
                        </div>
                        <span style="font-size:var(--text-xs);font-weight:600;color:var(--text-primary);min-width:76px;text-align:right;font-variant-numeric:tabular-nums">₡ @cat.Total.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- ═══════════════════════════════════════════════
     RECENT TRANSACTIONS
     ═══════════════════════════════════════════════ -->
<div class="home-section" style="padding-bottom:var(--sp-5)">
    <div class="home-section__header">
        <span class="home-section__title">Últimos movimientos</span>
        <a class="home-section__link" href="/transactions">Ver todos</a>
    </div>

    @if (Model.RecentTransactions.Any())
    {
        <div class="card">
            <div class="tx-feed">
                @foreach (var tx in Model.RecentTransactions)
                {
                    var initial  = tx.Merchant?.Length > 0 ? tx.Merchant[0].ToString().ToUpper() : "?";
                    var amtStyle = tx.Currency == "USD" ? "color:var(--brand-500)" : "";
                    var symbol   = tx.Currency == "CRC" ? "₡" : "$";
                    <div class="tx-item">
                        <div class="tx-item__merchant">@initial</div>
                        <div class="tx-item__info">
                            <div class="tx-item__name">@tx.Merchant</div>
                            <div class="tx-item__meta">
                                @tx.Bank
                                @if (tx.Category != null)
                                {
                                    <text> · </text><span class="tx-item__chip">@tx.Category.IconEmoji @tx.Category.Name</span>
                                }
                            </div>
                        </div>
                        <div class="tx-item__right">
                            <div class="tx-item__amount" style="@amtStyle">@symbol @tx.Amount.ToString("N2")</div>
                            <div style="font-size:var(--text-xs);color:var(--text-disabled);margin-top:2px">@tx.TransactionDate.ToString("dd/MM")</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="empty">
            <div class="empty__icon">💳</div>
            <div class="empty__title">Sin movimientos recientes</div>
            <a class="btn btn--primary btn--sm" href="/transactions/create" style="margin-top:var(--sp-3)">Registrar movimiento</a>
        </div>
    }
</div>

<!-- ═══════════════════════════════════════════════
     EXCHANGE RATE WIDGET
     ═══════════════════════════════════════════════ -->
@if (!Model.ExchangeRate.IsError)
{
    var er       = Model.ExchangeRate;
    var compraJs = er.Compra.ToString("F4", CultureInfo.InvariantCulture);
    var ventaJs  = er.Venta.ToString("F4",  CultureInfo.InvariantCulture);

    <div class="home-section" style="padding-bottom:var(--sp-6)">
        <div class="home-section__header">
            <span class="home-section__title">Tipo de cambio · BCCR</span>
            <a class="home-section__link" href="/exchange">Detalle</a>
        </div>
        <div class="card">
            <div class="card__body" style="padding:var(--sp-4) var(--sp-5)">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-bottom:var(--sp-4)">
                    <div>
                        <div style="font-size:var(--text-2xs);font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-disabled);margin-bottom:var(--sp-1)">Compra</div>
                        <div style="font-size:var(--text-2xl);font-weight:800;color:var(--success-600);font-variant-numeric:tabular-nums;letter-spacing:-.02em">₡ @er.Compra.ToString("N2")</div>
                        <div style="font-size:var(--text-2xs);color:var(--text-muted)">banco compra USD</div>
                    </div>
                    <div style="text-align:right">
                        <div style="font-size:var(--text-2xs);font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-disabled);margin-bottom:var(--sp-1)">Venta</div>
                        <div style="font-size:var(--text-2xl);font-weight:800;color:var(--brand-500);font-variant-numeric:tabular-nums;letter-spacing:-.02em">₡ @er.Venta.ToString("N2")</div>
                        <div style="font-size:var(--text-2xs);color:var(--text-muted)">banco vende USD</div>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:var(--sp-2)">
                    <input id="erInput" type="number" min="0" step="0.01" class="input" placeholder="0.00"
                           style="flex:1;min-width:70px;text-align:right" oninput="dbCalc()" />
                    <select id="erFrom" class="select" style="width:76px" onchange="dbCalc()">
                        <option value="USD">USD</option>
                        <option value="CRC">CRC</option>
                    </select>
                    <span style="color:var(--text-disabled)">→</span>
                    <div id="erResult"
                         style="flex:1;min-width:88px;font-size:var(--text-sm);font-weight:700;color:var(--text-primary);text-align:right;padding:var(--sp-2) var(--sp-3);background:var(--neutral-50);border:1px solid var(--border-default);border-radius:var(--radius-lg);font-variant-numeric:tabular-nums">
                        —
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(er.Updated))
                {
                    <div style="font-size:var(--text-2xs);color:var(--text-disabled);margin-top:var(--sp-2)">@er.Updated</div>
                }
            </div>
        </div>
    </div>

    <script>
    (function(){
        var C=@Html.Raw(compraJs), V=@Html.Raw(ventaJs);
        window.dbCalc = function(){
            var v = parseFloat(document.getElementById('erInput').value);
            var f = document.getElementById('erFrom').value;
            var r = document.getElementById('erResult');
            if (isNaN(v) || v <= 0) { r.textContent = '—'; return; }
            if (f === 'USD') r.textContent = '₡ ' + (v * V).toLocaleString('es-CR', {minimumFractionDigits:2, maximumFractionDigits:2});
            else             r.textContent = '$ ' + (v / C).toLocaleString('es-CR', {minimumFractionDigits:2, maximumFractionDigits:4});
        };
    })();
    </script>
}

@section Scripts {
<script>
(function(){
    if (!@Html.Raw(hasDailyData.ToString().ToLower())) return;
    var raw;
    try { raw = @Html.Raw(Model.DailySpendingJson); } catch(e) { return; }
    if (!raw || !raw.length) return;

    var ctx = document.getElementById('dailyChart');
    if (!ctx) return;

    new Chart(ctx.getContext('2d'), {
        type: 'bar',
        data: {
            labels: raw.map(function(d){ return d.date; }),
            datasets: [{
                data: raw.map(function(d){ return d.total; }),
                backgroundColor: 'rgba(37,99,235,0.12)',
                borderColor:     'rgba(37,99,235,0.7)',
                borderWidth: 1.5,
                borderRadius: 6,
                borderSkipped: false
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(c){ return '₡ ' + c.raw.toLocaleString('es-CR'); }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font:{size:9}, color:'#94a3b8', maxTicksLimit:16 }
                },
                y: {
                    grid: { color:'rgba(0,0,0,0.04)' },
                    ticks: {
                        font:{size:9}, color:'#94a3b8',
                        callback: function(v){ return '₡'+(v/1000).toFixed(0)+'k'; }
                    }
                }
            }
        }
    });
})();
</script>
}
