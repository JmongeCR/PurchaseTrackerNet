@model DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    var now        = DateTime.Now;
    var greeting   = now.Hour < 12 ? "Buenos días" : now.Hour < 19 ? "Buenas tardes" : "Buenas noches";
    var userName   = (User.Identity?.Name ?? "").Split('@')[0];
    var currSpend  = Model.MonthSpendingCrc;
    var prevSpend  = Model.PrevMonthSpendingCrc;
    decimal varPct = prevSpend > 0 ? (currSpend - prevSpend) / prevSpend * 100m : 0m;
    var varSign    = varPct >= 0 ? "+" : "";
    var nextPmt    = Model.NextPayments.FirstOrDefault();
    bool hasDailyData = Model.DailySpendingJson != "[]";
}

<style>
/* ── Layout ─────────────────────────────── */
.db-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:12px}
.db-greeting{font-size:24px;font-weight:700;color:#0f172a;line-height:1.15}
.db-period{font-size:13px;color:#94a3b8;margin-top:4px;font-weight:500}
.db-section-hdr{display:flex;align-items:center;gap:12px;margin-bottom:16px;margin-top:8px}
.db-section-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#94a3b8;white-space:nowrap}
.db-section-rule{flex:1;height:1px;background:#f1f5f9}

/* ── Cards ──────────────────────────────── */
.db-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden}
.db-card-hdr{padding:14px 20px;border-bottom:1px solid #f8fafc;display:flex;align-items:center;justify-content:space-between}
.db-card-title{font-size:13px;font-weight:600;color:#0f172a}
.db-card-link{font-size:12px;color:#3b82f6;text-decoration:none;font-weight:500;white-space:nowrap}
.db-card-link:hover{text-decoration:underline}

/* ── KPI ────────────────────────────────── */
.db-kpi{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:22px 22px 18px;height:100%;display:flex;flex-direction:column}
.db-kpi-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#94a3b8;margin-bottom:10px}
.db-kpi-val{font-size:28px;font-weight:700;color:#0f172a;line-height:1.1;font-variant-numeric:tabular-nums}
.db-kpi-val.sm{font-size:22px}
.db-kpi-val.xs{font-size:16px}
.db-kpi-sub{font-size:12px;color:#94a3b8;margin-top:6px}
.db-badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;margin-top:8px}
.db-badge.up{background:#fef2f2;color:#dc2626}
.db-badge.dn{background:#f0fdf4;color:#16a34a}
.db-badge.fl{background:#f8fafc;color:#64748b}

/* ── Payment items ──────────────────────── */
.db-pay{display:flex;align-items:center;gap:12px;padding:12px 20px;border-bottom:1px solid #f8fafc;transition:background .15s}
.db-pay:last-child{border-bottom:none}
.db-pay:hover{background:#fafafa}
.db-pay-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.db-pay-main{flex:1;min-width:0}
.db-pay-name{font-size:13px;font-weight:600;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.db-pay-meta{font-size:11px;color:#94a3b8;margin-top:1px}
.db-pay-right{text-align:right;flex-shrink:0}
.db-pay-amt{font-size:13px;font-weight:700;color:#0f172a;font-variant-numeric:tabular-nums}
.db-day{font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;display:inline-block;margin-top:3px}
.db-day.red{background:#fef2f2;color:#dc2626}
.db-day.amb{background:#fffbeb;color:#d97706}
.db-day.gry{background:#f8fafc;color:#94a3b8}

/* ── Transaction rows ───────────────────── */
.db-tx{display:flex;align-items:center;gap:12px;padding:10px 20px;border-bottom:1px solid #f8fafc;transition:background .15s}
.db-tx:last-child{border-bottom:none}
.db-tx:hover{background:#fafafa}
.db-tx-av{width:32px;height:32px;border-radius:8px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#475569;flex-shrink:0;font-family:monospace}
.db-tx-main{flex:1;min-width:0}
.db-tx-name{font-size:13px;font-weight:600;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.db-tx-meta{font-size:11px;color:#94a3b8;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.db-tx-right{text-align:right;flex-shrink:0}
.db-tx-amt{font-size:13px;font-weight:700;font-variant-numeric:tabular-nums}
.db-tx-date{font-size:11px;color:#94a3b8;margin-top:2px}

/* ── Category list ──────────────────────── */
.db-cat-row{display:flex;align-items:center;gap:10px;padding:9px 20px;border-bottom:1px solid #f8fafc}
.db-cat-row:last-child{border-bottom:none}
.db-cat-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.db-cat-name{font-size:12px;color:#475569;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.db-cat-bar-wrap{width:54px;height:4px;background:#f1f5f9;border-radius:2px;flex-shrink:0}
.db-cat-bar{height:4px;border-radius:2px}
.db-cat-amt{font-size:12px;font-weight:600;color:#0f172a;min-width:72px;text-align:right;font-variant-numeric:tabular-nums}

/* ── Mini widgets ───────────────────────── */
.db-mini{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:18px 20px}
.db-mini-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#94a3b8;margin-bottom:12px}
.db-er-pair{display:flex;justify-content:space-between;gap:12px;margin-bottom:14px}
.db-er-side{flex:1}
.db-er-dir{font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:.04em}
.db-er-val{font-size:20px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.2}

/* ── Empty states ───────────────────────── */
.db-empty{padding:32px 20px;text-align:center}
.db-empty-ico{font-size:28px;margin-bottom:8px}
.db-empty-txt{font-size:13px;color:#94a3b8}
.db-empty-lnk{font-size:12px;color:#3b82f6;text-decoration:none;margin-top:8px;display:block}

@@media(max-width:575px){
    .db-greeting{font-size:19px}
    .db-kpi-val{font-size:22px}
    .db-kpi-val.sm{font-size:18px}
}
</style>

<!-- ═══════════════════════════════════════
     HEADER
     ═══════════════════════════════════════ -->
<div class="db-header">
    <div>
        <div class="db-greeting">@greeting@(string.IsNullOrWhiteSpace(userName) ? "" : $", {userName}")</div>
        <div class="db-period">@Model.CurrentMonthLabel · @Model.MonthTransactionCount transacción(es) registradas</div>
    </div>
    <a href="/transactions" class="btn btn-primary" style="font-size:13px;padding:8px 18px;flex-shrink:0">
        + Agregar movimiento
    </a>
</div>

<!-- ═══════════════════════════════════════
     KPIs
     ═══════════════════════════════════════ -->
<div class="row g-3 mb-5">

    <!-- Gasto del mes -->
    <div class="col-6 col-lg-3">
        <div class="db-kpi">
            <div class="db-kpi-lbl">Gasto del mes</div>
            @if (currSpend > 0)
            {
                <div class="db-kpi-val sm">₡ @currSpend.ToString("N0")</div>
                @if (Model.MonthSpendingUsd > 0)
                {
                    <div class="db-kpi-sub" style="margin-top:4px">+ $ @Model.MonthSpendingUsd.ToString("N2") USD</div>
                }
                <div class="db-kpi-sub">@(Model.MonthTransactionCount - Model.MonthUsdTransactionCount) transacciones CRC</div>
            }
            else if (Model.MonthSpendingUsd > 0)
            {
                <div class="db-kpi-val sm">$ @Model.MonthSpendingUsd.ToString("N2")</div>
                <div class="db-kpi-sub">@Model.MonthUsdTransactionCount transacciones USD</div>
            }
            else
            {
                <div class="db-kpi-val" style="color:#94a3b8;font-size:22px">₡ 0</div>
                <div class="db-kpi-sub">Sin movimientos este mes</div>
            }
        </div>
    </div>

    <!-- Cuotas del mes -->
    <div class="col-6 col-lg-3">
        <div class="db-kpi">
            <div class="db-kpi-lbl">Cuotas del mes</div>
            @if (Model.TotalMonthlyCommitment > 0 || Model.TotalMonthlyCommitmentUsd > 0)
            {
                @if (Model.TotalMonthlyCommitment > 0)
                {
                    <div class="db-kpi-val sm" style="color:#7c3aed">₡ @Model.TotalMonthlyCommitment.ToString("N0")</div>
                }
                @if (Model.TotalMonthlyCommitmentUsd > 0)
                {
                    <div class="db-kpi-sub" style="color:#7c3aed;font-weight:700">$ @Model.TotalMonthlyCommitmentUsd.ToString("N2") USD</div>
                }
                <div class="db-kpi-sub">@Model.ActiveFinancingsCount financiamiento(s) activos</div>
                <a href="/financing" style="font-size:11px;color:#7c3aed;text-decoration:none;margin-top:auto;padding-top:10px;display:block">Ver detalle →</a>
            }
            else
            {
                <div class="db-kpi-val" style="color:#94a3b8;font-size:22px">₡ 0</div>
                <div class="db-kpi-sub">Sin financiamientos activos</div>
                <a href="/financing" style="font-size:11px;color:#94a3b8;text-decoration:none;margin-top:auto;padding-top:10px;display:block">Registrar uno →</a>
            }
        </div>
    </div>

    <!-- Próximo pago -->
    <div class="col-6 col-lg-3">
        <div class="db-kpi">
            <div class="db-kpi-lbl">Próximo pago</div>
            @if (nextPmt != null)
            {
                var d = nextPmt.DaysUntil;
                var uc = d <= 3 ? "#dc2626" : d <= 7 ? "#d97706" : "#0f172a";
                <div class="db-kpi-val xs" style="color:@uc;margin-bottom:4px">@nextPmt.Name</div>
                <div class="db-kpi-sub">@nextPmt.Date.ToString("dd MMM yyyy")</div>
                <div class="db-kpi-sub" style="margin-top:2px">
                    <strong style="color:@uc">@(nextPmt.Currency == "USD" ? "$" : "₡") @nextPmt.Amount.ToString("N2")</strong>
                </div>
                <span class="db-badge @(d <= 3 ? "up" : d <= 7 ? "fl" : "fl")" style="@(d <= 3 ? "" : d <= 7 ? "background:#fffbeb;color:#d97706" : "")">
                    @(d <= 0 ? "¡Vencido!" : d == 1 ? "Mañana" : $"en {d} días")
                </span>
            }
            else
            {
                <div class="db-kpi-val" style="font-size:30px">✅</div>
                <div class="db-kpi-sub">Sin pagos próximos</div>
            }
        </div>
    </div>

    <!-- Variación mensual -->
    <div class="col-6 col-lg-3">
        <div class="db-kpi">
            <div class="db-kpi-lbl">Variación mensual</div>
            @if (prevSpend > 0)
            {
                var vc = varPct > 0 ? "#dc2626" : varPct < 0 ? "#16a34a" : "#64748b";
                <div class="db-kpi-val" style="color:@vc">@varSign@varPct.ToString("N1")%</div>
                <div class="db-kpi-sub">vs. ₡ @prevSpend.ToString("N0") mes anterior</div>
                <span class="db-badge @(varPct > 5 ? "up" : varPct < -5 ? "dn" : "fl")">
                    @(varPct > 5 ? "↑ Subió" : varPct < -5 ? "↓ Bajó" : "→ Estable")
                </span>
            }
            else
            {
                <div class="db-kpi-val" style="color:#94a3b8;font-size:22px">—</div>
                <div class="db-kpi-sub">Sin datos del mes anterior</div>
            }
        </div>
    </div>

</div>

<!-- ═══════════════════════════════════════
     ANÁLISIS
     ═══════════════════════════════════════ -->
<div class="db-section-hdr">
    <span class="db-section-lbl">Análisis</span>
    <div class="db-section-rule"></div>
    <span style="font-size:11px;color:#94a3b8;white-space:nowrap">@Model.CurrentMonthLabel</span>
</div>

<div class="row g-3 mb-5">

    <!-- Gasto diario -->
    <div class="col-xl-7">
        <div class="db-card h-100">
            <div class="db-card-hdr">
                <span class="db-card-title">Gasto diario</span>
                <span style="font-size:11px;color:#94a3b8">CRC · barras por día</span>
            </div>
            <div style="padding:16px 20px">
                @if (hasDailyData)
                {
                    <div style="height:220px;position:relative">
                        <canvas id="dailyChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="db-empty">
                        <div class="db-empty-ico">📊</div>
                        <div class="db-empty-txt">Sin movimientos CRC este mes</div>
                        <a class="db-empty-lnk" href="/transactions">Registrar movimiento →</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Gasto por categoría -->
    <div class="col-xl-5">
        <div class="db-card h-100">
            <div class="db-card-hdr">
                <span class="db-card-title">Por categoría</span>
                <a class="db-card-link" href="/transactions">Ver movimientos →</a>
            </div>
            @if (Model.SpendingByCategory.Any())
            {
                var catMax = Model.SpendingByCategory.Max(c => c.Total);
                <div style="padding:6px 0">
                    @foreach (var cat in Model.SpendingByCategory)
                    {
                        var pct = catMax > 0 ? (double)(cat.Total / catMax) * 100.0 : 0;
                        <div class="db-cat-row">
                            <div class="db-cat-dot" style="background:@cat.Color"></div>
                            <span style="font-size:14px;line-height:1">@cat.Icon</span>
                            <span class="db-cat-name">@cat.CategoryName</span>
                            <div class="db-cat-bar-wrap">
                                <div class="db-cat-bar" style="width:@pct.ToString("F0", CultureInfo.InvariantCulture)%;background:@cat.Color"></div>
                            </div>
                            <span class="db-cat-amt">₡ @cat.Total.ToString("N0")</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="db-empty">
                    <div class="db-empty-ico">🏷️</div>
                    <div class="db-empty-txt">Sin categorías asignadas este mes</div>
                    <a class="db-empty-lnk" href="/transactions">Ir a movimientos →</a>
                </div>
            }
        </div>
    </div>

</div>

<!-- ═══════════════════════════════════════
     ACTIVIDAD
     ═══════════════════════════════════════ -->
<div class="db-section-hdr">
    <span class="db-section-lbl">Actividad</span>
    <div class="db-section-rule"></div>
</div>

<div class="row g-3 mb-5">

    <!-- Próximos pagos -->
    <div class="col-xl-4">
        <div class="db-card h-100">
            <div class="db-card-hdr">
                <span class="db-card-title">Próximos pagos</span>
                <a class="db-card-link" href="/financing">Financiamientos →</a>
            </div>
            @if (Model.NextPayments.Any())
            {
                @foreach (var p in Model.NextPayments)
                {
                    var d      = p.DaysUntil;
                    var iconBg = p.Type == "financing" ? "#ede9fe" : "#dbeafe";
                    var icon   = p.Type == "financing" ? "📋" : "🔄";
                    var dCls   = d <= 3 ? "red" : d <= 7 ? "amb" : "gry";
                    var dTxt   = d < 0 ? "Vencido" : d == 0 ? "¡Hoy!" : d == 1 ? "Mañana" : $"{d}d";
                    <div class="db-pay">
                        <div class="db-pay-icon" style="background:@iconBg">@icon</div>
                        <div class="db-pay-main">
                            <div class="db-pay-name">@p.Name</div>
                            <div class="db-pay-meta">@p.Date.ToString("dd/MM/yyyy") · @(p.Detail ?? "")</div>
                        </div>
                        <div class="db-pay-right">
                            <div class="db-pay-amt">@(p.Currency == "USD" ? "$" : "₡") @p.Amount.ToString("N2")</div>
                            <span class="db-day @dCls">@dTxt</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="db-empty">
                    <div class="db-empty-ico">✅</div>
                    <div class="db-empty-txt">Sin pagos próximos programados</div>
                </div>
            }
        </div>
    </div>

    <!-- Movimientos recientes -->
    <div class="col-xl-8">
        <div class="db-card h-100">
            <div class="db-card-hdr">
                <span class="db-card-title">Movimientos recientes</span>
                <a class="db-card-link" href="/transactions">Ver todos →</a>
            </div>
            @if (Model.RecentTransactions.Any())
            {
                @foreach (var tx in Model.RecentTransactions)
                {
                    var initial  = tx.Merchant.Length > 0 ? tx.Merchant[0].ToString().ToUpper() : "?";
                    var amtColor = tx.Currency == "USD" ? "#0369a1" : "#0f172a";
                    <div class="db-tx">
                        <div class="db-tx-av">@initial</div>
                        <div class="db-tx-main">
                            <div class="db-tx-name">@tx.Merchant</div>
                            <div class="db-tx-meta">
                                @tx.Bank@(tx.Category != null ? " · " : "")@if (tx.Category != null)
                                {<span style="color:@tx.Category.Color;font-weight:600">@tx.Category.IconEmoji @tx.Category.Name</span>}
                            </div>
                        </div>
                        <div class="db-tx-right">
                            <div class="db-tx-amt" style="color:@amtColor">
                                @(tx.Currency == "CRC" ? "₡" : "$") @tx.Amount.ToString("N2")
                            </div>
                            <div class="db-tx-date">@tx.TransactionDate.ToString("dd/MM/yy")</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="db-empty">
                    <div class="db-empty-ico">💳</div>
                    <div class="db-empty-txt">Sin movimientos recientes</div>
                    <a class="db-empty-lnk" href="/transactions">Registrar movimiento →</a>
                </div>
            }
        </div>
    </div>

</div>

<!-- ═══════════════════════════════════════
     MINI WIDGETS
     ═══════════════════════════════════════ -->
<div class="db-section-hdr">
    <span class="db-section-lbl">Información adicional</span>
    <div class="db-section-rule"></div>
</div>

<div class="row g-3 mb-4">

    <!-- Tipo de cambio -->
    @if (!Model.ExchangeRate.IsError)
    {
        var er      = Model.ExchangeRate;
        var compraJs = er.Compra.ToString("F4", CultureInfo.InvariantCulture);
        var ventaJs  = er.Venta.ToString("F4",  CultureInfo.InvariantCulture);
        <div class="col-md-6 col-xl-4">
            <div class="db-mini">
                <div class="db-mini-lbl">💱 Tipo de cambio · BCCR</div>
                <div class="db-er-pair">
                    <div class="db-er-side">
                        <div class="db-er-dir">Compra</div>
                        <div class="db-er-val" style="color:#10b981">₡ @er.Compra.ToString("N2")</div>
                        <div style="font-size:10px;color:#94a3b8">banco compra USD</div>
                    </div>
                    <div class="db-er-side" style="text-align:right">
                        <div class="db-er-dir">Venta</div>
                        <div class="db-er-val" style="color:#3b82f6">₡ @er.Venta.ToString("N2")</div>
                        <div style="font-size:10px;color:#94a3b8">banco vende USD</div>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:6px">
                    <input id="miniConvInput" type="number" min="0" step="0.01"
                           class="form-control form-control-sm" placeholder="0.00"
                           style="flex:1;min-width:70px;font-size:13px;font-weight:600;text-align:right"
                           oninput="miniCalc()" />
                    <select id="miniConvFrom" class="form-select form-select-sm"
                            style="width:72px;font-size:12px;font-weight:600" onchange="miniCalc()">
                        <option value="USD">USD</option>
                        <option value="CRC">CRC</option>
                    </select>
                    <span style="color:#94a3b8">→</span>
                    <div id="miniConvResult"
                         style="flex:1;min-width:80px;font-size:13px;font-weight:700;color:#0f172a;text-align:right;padding:5px 10px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;font-variant-numeric:tabular-nums">
                        —
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(er.Updated))
                {
                    <div style="font-size:10px;color:#94a3b8;margin-top:8px">@er.Updated</div>
                }
                <script>
                (function(){
                    var C=@Html.Raw(compraJs), V=@Html.Raw(ventaJs);
                    window.miniCalc=function(){
                        var v=parseFloat(document.getElementById('miniConvInput').value);
                        var f=document.getElementById('miniConvFrom').value;
                        var r=document.getElementById('miniConvResult');
                        if(isNaN(v)||v<=0){r.textContent='—';return;}
                        if(f==='USD') r.textContent='₡ '+(v*V).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2});
                        else          r.textContent='$ '+(v/C).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:4});
                    };
                })();
                </script>
            </div>
        </div>
    }

    <!-- Tarjetas activas -->
    <div class="col-md-6 col-xl-4">
        <div class="db-mini" style="display:flex;align-items:center;gap:16px;height:100%">
            <div style="width:50px;height:50px;border-radius:12px;background:#eff6ff;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0">🏦</div>
            <div>
                <div class="db-mini-lbl" style="margin-bottom:4px">Tarjetas activas</div>
                <div style="font-size:30px;font-weight:700;color:#1e40af;line-height:1">@Model.ActiveCardsCount</div>
                <a href="/cards" style="font-size:12px;color:#3b82f6;text-decoration:none;margin-top:4px;display:block">Gestionar tarjetas →</a>
            </div>
        </div>
    </div>

    <!-- Suscripciones -->
    <div class="col-md-6 col-xl-4">
        <div class="db-mini" style="display:flex;align-items:center;gap:16px;height:100%">
            <div style="width:50px;height:50px;border-radius:12px;background:#f5f3ff;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0">🔄</div>
            <div>
                <div class="db-mini-lbl" style="margin-bottom:4px">Suscripciones</div>
                <div style="font-size:30px;font-weight:700;color:#6d28d9;line-height:1">@Model.ActiveSubscriptionsCount</div>
                @if (Model.TotalMonthlySubscriptionsCrc > 0)
                {
                    <div style="font-size:12px;color:#64748b;margin-top:2px">₡ @Model.TotalMonthlySubscriptionsCrc.ToString("N0") / mes</div>
                }
                <a href="/subscriptions" style="font-size:12px;color:#6d28d9;text-decoration:none;margin-top:4px;display:block">Ver suscripciones →</a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
(function(){
    if (!@Html.Raw(hasDailyData.ToString().ToLower())) return;
    var raw;
    try { raw = @Html.Raw(Model.DailySpendingJson); } catch(e) { return; }
    if (!raw || !raw.length) return;

    var ctx = document.getElementById('dailyChart');
    if (!ctx) return;

    new Chart(ctx.getContext('2d'), {
        type: 'bar',
        data: {
            labels: raw.map(function(d){ return d.date; }),
            datasets: [{
                data: raw.map(function(d){ return d.total; }),
                backgroundColor: 'rgba(59,130,246,0.10)',
                borderColor:     'rgba(59,130,246,0.65)',
                borderWidth: 1.5,
                borderRadius: 5,
                borderSkipped: false
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(c){ return '₡ ' + c.raw.toLocaleString('es-CR'); }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font:{size:9}, color:'#94a3b8', maxTicksLimit:16 }
                },
                y: {
                    grid: { color:'rgba(0,0,0,0.03)' },
                    ticks: {
                        font:{size:9}, color:'#94a3b8',
                        callback: function(v){ return '₡'+(v/1000).toFixed(0)+'k'; }
                    }
                }
            }
        }
    });
})();
</script>
}
