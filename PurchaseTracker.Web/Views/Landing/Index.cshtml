<!-- ── SECURITY ───────────────────────────────────────────────── -->
<section class="security" id="security">
  <div class="security-inner">
    <div class="security-text">
      <div class="section-tag"><i data-lucide="shield-check"></i> Seguridad</div>
      <h2 class="section-h">Tu privacidad es<br><span>nuestra prioridad</span></h2>
      <p class="section-sub" style="margin-bottom:0">No somos un banco. No tenemos acceso a tus cuentas. Tus datos son tuyos.</p>
      <div class="security-grid">
        <div class="sec-card">
          <div class="sec-icon" style="background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.25)">
            <i data-lucide="lock" style="color:#34D399"></i>
          </div>
          <div>
            <div class="sec-h">Contraseñas encriptadas</div>
            <p class="sec-p">Las contraseñas se guardan con hash BCrypt. Nadie puede verlas.</p>
          </div>
        </div>
        <div class="sec-card">
          <div class="sec-icon" style="background:rgba(59,130,246,.12);border:1px solid rgba(59,130,246,.25)">
            <i data-lucide="database" style="color:#60A5FA"></i>
          </div>
          <div>
            <div class="sec-h">Sin datos bancarios</div>
            <p class="sec-p">Nunca pedimos números de cuenta, claves de banca en línea ni datos sensibles.</p>
          </div>
        </div>
        <div class="sec-card">
          <div class="sec-icon" style="background:rgba(99,102,241,.12);border:1px solid rgba(99,102,241,.25)">
            <i data-lucide="server" style="color:#818CF8"></i>
          </div>
